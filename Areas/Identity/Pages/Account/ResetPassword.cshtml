@page
@model ResetPasswordModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="ez-sign-layout">
    <!-- LEFT: FULL-BLEED CITYSCAPE PHOTO -->
    <section class="ez-sign-photo" aria-label="Hình ảnh đô thị EZ-Rent">
        <img src="~/images/auth/city-login.jpg" alt="Không gian sống đô thị lúc hoàng hôn" class="ez-sign-photo-img" />
        <div class="ez-sign-photo-caption">
            Không gian sống đô thị · <a asp-area="" asp-controller="RentalPost" asp-action="Index">Khám phá phòng trống</a>
        </div>
    </section>

    <!-- RIGHT: RESET PASSWORD SIDEBAR -->
    <section class="ez-sign-panel">
        <div class="ez-sign-top">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="ez-sign-brand" title="Về trang chủ EZ-Rent">
                <img src="~/images/brand/logo-icon.png" alt="EZ-Rent Logo" class="ez-sign-brand-logo" />
                <span class="ez-brand-wordmark" style="font-size: 20px;">
                    <span class="ez-brand-ez">ez</span><span class="ez-brand-rent">rent</span>
                </span>
            </a>

            <h1 class="ez-sign-title">Thiết lập mật khẩu mới</h1>
            <p class="ez-sign-subtitle">
                Vui lòng xác nhận email tài khoản và nhập mật khẩu mới an toàn cho lần đăng nhập tiếp theo.
            </p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />

                <div class="ez-sign-field">
                    <label asp-for="Input.Email" class="ez-sign-label">Email tài khoản</label>
                    <div class="ez-sign-input-wrap">
                        <input asp-for="Input.Email"
                               class="ez-sign-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="Nhập địa chỉ email" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="ez-sign-field">
                    <label asp-for="Input.Password" class="ez-sign-label">Mật khẩu mới</label>
                    <div class="ez-sign-input-wrap">
                        <input asp-for="Input.Password"
                               id="reset-password-input"
                               class="ez-sign-input has-toggle"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Tối thiểu 6 ký tự" />
                        <button type="button"
                                class="ez-pw-toggle"
                                data-pw-toggle="reset-password-input"
                                aria-label="Hiện hoặc ẩn mật khẩu mới"
                                title="Hiện / ẩn mật khẩu">
                            <svg class="pw-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="pw-eye-closed d-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 19c-7 0-11-7-11-7a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 7 11 7a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="ez-sign-field mb-4">
                    <label asp-for="Input.ConfirmPassword" class="ez-sign-label">Xác nhận mật khẩu mới</label>
                    <div class="ez-sign-input-wrap">
                        <input asp-for="Input.ConfirmPassword"
                               id="reset-confirm-input"
                               class="ez-sign-input has-toggle"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Nhập lại mật khẩu mới" />
                        <button type="button"
                                class="ez-pw-toggle"
                                data-pw-toggle="reset-confirm-input"
                                aria-label="Hiện hoặc ẩn mật khẩu xác nhận"
                                title="Hiện / ẩn mật khẩu">
                            <svg class="pw-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="pw-eye-closed d-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 19c-7 0-11-7-11-7a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 7 11 7a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small d-block mt-1"></span>
                </div>

                <button type="submit" class="ez-sign-submit">
                    Cập nhật mật khẩu mới
                </button>
            </form>

            <p class="ez-sign-prompt">
                Không cần thay đổi?<a asp-page="./Login">Quay lại đăng nhập</a>
            </p>
        </div>

        <footer class="ez-sign-footer">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="ez-sign-footer-brand">
                <img src="~/images/brand/logo-icon.png" alt="" />
                <span>@@ezrent.vn</span>
            </a>
            <span>&copy; EZ-Rent 2026</span>
        </footer>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-pw-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var target = document.getElementById(btn.getAttribute('data-pw-toggle'));
                if (!target) return;
                var show = target.type === 'password';
                target.type = show ? 'text' : 'password';
                btn.querySelector('.pw-eye-open')?.classList.toggle('d-none', show);
                btn.querySelector('.pw-eye-closed')?.classList.toggle('d-none', !show);
            });
        });
    </script>
}
