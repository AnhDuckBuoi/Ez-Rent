@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="ez-page-header mb-4 pb-3 border-bottom">
    <div>
        <span class="ez-eyebrow">TÀI KHOẢN CỦA BẠN</span>
        <h1 class="ez-page-title">Cài đặt tài khoản</h1>
        <p class="ez-page-subtitle">Cập nhật thông tin cá nhân, bảo mật và phiên đăng nhập.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-md-9">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
