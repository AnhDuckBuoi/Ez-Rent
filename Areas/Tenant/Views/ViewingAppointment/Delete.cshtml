@model EZ_Rent.Areas.Tenant.ViewModels.AppointmentModel
@{ Layout = "_Layout"; ViewData["Title"] = "Xác nhận hủy lịch"; ViewData["AppointmentsPage"] = true; }
<div class="appointment-detail">
    <a asp-action="Details" asp-route-id="@Model.Id" class="back-link">← Quay lại chi tiết</a>
    <section class="detail-section cancellation-panel">
        <span class="empty-symbol" aria-hidden="true">×</span>
        <h1>Hủy lịch hẹn này?</h1>
        <p>Lịch sử và phản hồi của chủ nhà vẫn được giữ lại. Sau khi hủy, bạn sẽ không còn lịch xem phòng này.</p>
        <h2>@Model.Title</h2><p class="appointment-address">@Model.Address</p>
        <div class="appointment-time"><span aria-hidden="true">▦</span><div><strong>@Model.TimeLabel</strong><span>@Model.DateLabel</span></div></div>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-cancel-appointment>
            <a asp-action="Details" asp-route-id="@Model.Id" class="button">Giữ lịch hẹn</a>
            <button type="submit" class="button danger solid">Xác nhận hủy lịch</button>
        </form>
    </section>
</div>
