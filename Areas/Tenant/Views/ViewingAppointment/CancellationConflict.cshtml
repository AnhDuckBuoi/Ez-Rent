@{
    Layout = "_Layout";
    ViewData["Title"] = "Lịch hẹn đã thay đổi";
    ViewData["AppointmentsPage"] = true;
}

<div class="ez-appt-shell">
    <section class="ez-appt-empty" role="alert">
        <div class="ez-appt-empty-icon is-amber" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
        </div>
        <h1>Lịch hẹn đã thay đổi</h1>
        <p>Lịch đã được xử lý nên không thể hủy ở trạng thái hiện tại. Hãy xem lại thông tin cập nhật mới nhất.</p>
        <a asp-action="Details" asp-route-id="@ViewData["AppointmentId"]" class="ez-discover-submit">Xem lại lịch hẹn</a>
    </section>
</div>
