@using EZ_Rent.Helpers
@model EZ_Rent.Areas.Tenant.ViewModels.RentalSearchPageModel
@if (!Model.IsFavorites && Model.Recommendations.Count > 0)
{
    <section class="ez-discover-recs" aria-label="Phòng gợi ý">
        <div class="ez-home-section-head mb-3">
            <div>
                <p class="ez-home-kicker">ĐỀ XUẤT CÁ NHÂN HÓA</p>
                <h2 class="ez-home-heading">Gợi ý cho bạn</h2>
            </div>
        </div>
        <div class="ez-discover-rec-grid">
            @foreach (var room in Model.Recommendations)
            {
                var recImg = RoomPhotoHelper.ResolveUrl(room.ImageUrl, room.RentalPostId, room.RoomType);
                <a asp-area="Tenant" asp-controller="RentalPost" asp-action="Details" asp-route-id="@room.RentalPostId" asp-route-returnUrl="@Model.CurrentUrl" class="ez-discover-rec-card">
                    <img src="@recImg" alt="@room.Title" loading="lazy" data-fallback="/images/room-placeholder.svg" />
                    <span class="ez-discover-rec-info">
                        <strong>@room.Title</strong>
                        <small class="ez-discover-rec-price">@room.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ / tháng</small>
                        @if (room.IsSaved)
                        {
                            <small class="ez-discover-rec-saved">Đã lưu yêu thích</small>
                        }
                    </span>
                </a>
            }
        </div>
    </section>
}
@{
    var chips = Model.IsFavorites ? new List<EZ_Rent.Areas.Tenant.ViewModels.RentalFilterChip>() : Model.Filters.ActiveFilters();
}
@if (chips.Count > 0)
{
    <nav class="active-filters ez-active-chips" aria-label="Điều kiện đang áp dụng">
        @foreach (var chip in chips)
        {
            <a href="@Url.Action("Index", "RentalPost", Model.Filters.WithoutFilter(chip.Keys))"
               data-filter-link
               data-filter-key="@chip.Keys[0]"
               class="filter-chip ez-chip-pill"
               aria-label="Bỏ điều kiện @chip.Label">
                <span>@chip.Label</span>
                <span aria-hidden="true">×</span>
            </a>
        }
        <a asp-area="Tenant" asp-controller="RentalPost" asp-action="Index" data-filter-link class="clear-filters">Xóa tất cả</a>
    </nav>
}
<div class="ez-home-section-head mt-2">
    <div>
        <p class="ez-home-kicker">@(Model.IsFavorites ? "PHÒNG CỦA BẠN" : "KHÔNG GIAN ĐANG CHỜ BẠN")</p>
        <h2 class="ez-home-heading">
            @(Model.IsFavorites ? "Phòng đã lưu" : "Kết quả tìm phòng")
            <span class="ez-discover-total">(@Model.TotalCount)</span>
        </h2>
    </div>
</div>
<div asp-validation-summary="All" class="validation-errors" role="alert"></div>
@if (Model.Rooms.Count == 0)
{
    <div class="ez-discover-empty">
        <div class="ez-discover-empty-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </div>
        <h3>@(Model.IsFavorites ? "Bạn chưa lưu phòng nào" : "Chưa tìm thấy phòng phù hợp")</h3>
        <p>@(Model.IsFavorites ? "Lưu những căn phòng bạn thích bằng biểu tượng trái tim để xem lại và so sánh dễ dàng." : "Thử thay đổi khu vực, mức giá hoặc xóa bộ lọc để xem thêm lựa chọn.")</p>
        <a asp-area="Tenant" asp-controller="RentalPost" asp-action="Index" class="ez-discover-submit">@(Model.IsFavorites ? "Khám phá phòng" : "Xóa bộ lọc")</a>
    </div>
}
else
{
    <div class="rental-grid ez-home-grid-4">
        @foreach (var room in Model.Rooms)
        {
            <partial name="~/Areas/Tenant/Views/Shared/_RentalCard.cshtml" model="room" />
        }
    </div>
}
@await Html.PartialAsync("_TenantPagination", new EZ_Rent.Areas.Tenant.ViewModels.TenantPaginationModel(
    Model.Filters.Page, Model.TotalPages,
    page => Model.IsFavorites ? Url.Action("Index", "Favorite", new { page }) : Url.Action("Index", "RentalPost", Model.Filters.RouteValues(page)),
    "Phân trang phòng", true))
<template id="district-options"><option value="">Tất cả quận/huyện</option>@foreach (var district in Model.Districts) { <option value="@district" selected="@(district == Model.Filters.District)">@district</option> }</template>
<span data-current-url="@Model.CurrentUrl" data-filter-count-value="@chips.Count" hidden></span>
