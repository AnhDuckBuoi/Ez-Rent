@model EZ_Rent.Models.ApplicationUser

@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<h1>Chi tiết người dùng</h1>

<div class="card">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-2">
                <img src="@(Model.AvatarUrl ?? "https://i.pravatar.cc/150")"
                     class="rounded-circle" width="120" height="120"
                     style="object-fit:cover;" />
            </div>
            <div class="col-md-10">
                <h4>@Model.FullName</h4>
                <p class="text-muted mb-1">@Model.Email</p>
                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                {
                    <p class="text-muted mb-1">📞 @Model.PhoneNumber</p>
                }
                <p class="text-muted small">
                    Tham gia: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>
        </div>

        <dl class="row mb-0">
            @if (ViewBag.CurrentRoles != null)
            {
                <dt class="col-sm-3">Vai trò</dt>
                <dd class="col-sm-9">
                    @foreach (var role in (IEnumerable<string>)ViewBag.CurrentRoles)
                    {
                        <span class="badge bg-info text-dark me-1">@role</span>
                    }
                </dd>
            }

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                @if (Model.Status == EZ_Rent.Models.Enums.UserStatus.Locked)
                {
                    <span class="badge bg-danger">🔒 Đã khóa</span>
                }
                else
                {
                    <span class="badge bg-success">✅ Hoạt động</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa</a>
    <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại</a>
</div>