@model EZ_Rent.Areas.Tenant.ViewModels.ContractDraftPage
<section class="rental-panel bm03-form-section" aria-labelledby="draft-form-title">
    <div class="rental-section-heading"><div><h2 id="draft-form-title">Thông tin người thuê</h2><p class="rental-note">Lưu riêng cho hợp đồng này. Bạn có thể lưu khi còn thiếu thông tin và bổ sung sau.</p></div></div>
    @if (Model.Conflict)
    {
        <div class="bm03-alert" role="alert"><strong>Bản nháp hoặc nội dung hợp đồng vừa thay đổi.</strong><p>Thông tin vừa nhập vẫn ở bên dưới. Hãy mở bản mới nhất và kiểm tra trước khi lưu lại.</p><a asp-action="Draft" asp-route-id="@Model.Contract.RentalContractId" target="_blank" rel="noopener">Mở bản mới nhất trong tab riêng</a></div>
    }
    @if (Model.ContractChanged)
    {
        <div class="bm03-alert"><strong>Thông tin hợp đồng hiện tại khác bản nháp đang xem.</strong><p>Bản giấy bên dưới vẫn giữ dữ liệu đã lưu. Khi tạo phiên bản mới, khoản tiền và nội dung phía chủ nhà sẽ lấy từ thông tin hiện tại dưới đây.</p>
            <dl class="bm03-current-agreement">
                <div><dt>Chủ nhà hiện tại</dt><dd>@Model.Contract.Landlord.FullName · @Model.Contract.Landlord.PhoneNumber</dd></div>
                <div><dt>Địa chỉ phòng</dt><dd>@Model.Contract.RentalPost.Address, @Model.Contract.RentalPost.District, @Model.Contract.RentalPost.City</dd></div>
                <div><dt>Tiền thuê hiện tại</dt><dd>@EZ_Rent.Areas.Tenant.Services.TenantRentalPresentation.Money(Model.Contract.MonthlyRent)</dd></div>
                <div><dt>Tiền cọc hiện tại</dt><dd>@EZ_Rent.Areas.Tenant.Services.TenantRentalPresentation.Money(Model.Contract.DepositAmount)</dd></div>
                <div><dt>Giá điện hiện tại</dt><dd>@EZ_Rent.Areas.Tenant.Services.TenantRentalPresentation.Money(Model.Contract.AgreedElectricityPrice) / kWh</dd></div>
                <div><dt>Giá nước hiện tại</dt><dd>@EZ_Rent.Areas.Tenant.Services.TenantRentalPresentation.Money(Model.Contract.AgreedWaterPrice) / m³</dd></div>
                <div><dt>Thời hạn hiện tại</dt><dd>@Model.Contract.StartDate.ToString("dd/MM/yyyy") – @Model.Contract.EndDate.ToString("dd/MM/yyyy")</dd></div>
            </dl>
            <p><strong>Điều khoản hiện tại trong hợp đồng:</strong></p><p class="bm03-preserve">@(string.IsNullOrWhiteSpace(Model.Contract.Terms) ? "Chưa có điều khoản được lưu." : Model.Contract.Terms)</p>
        </div>
    }
    <form asp-action="SaveDraft" asp-route-id="@Model.Contract.RentalContractId" method="post" data-contract-draft-form data-draft-attempted="@((!ViewData.ModelState.IsValid || Model.Conflict) ? "true" : "false")">
        <input asp-for="Input.ExpectedRevision" type="hidden" /><input asp-for="Input.ContractStamp" type="hidden" />
        <div asp-validation-summary="All" class="bm03-validation" role="alert"></div>
        <fieldset class="bm03-fields"><legend>Thông tin cá nhân</legend>
            <div><label asp-for="Input.FullName"></label><input asp-for="Input.FullName" autocomplete="name" required /><span asp-validation-for="Input.FullName"></span></div>
            <div><label asp-for="Input.PhoneNumber"></label><input asp-for="Input.PhoneNumber" type="tel" autocomplete="tel" /><span asp-validation-for="Input.PhoneNumber"></span></div>
            <div><label asp-for="Input.DateOfBirth"></label><input asp-for="Input.DateOfBirth" type="date" asp-format="{0:yyyy-MM-dd}" autocomplete="bday" /><span asp-validation-for="Input.DateOfBirth"></span></div>
            <div class="bm03-field-wide"><label asp-for="Input.PermanentAddress"></label><textarea asp-for="Input.PermanentAddress" rows="2" autocomplete="street-address"></textarea><span asp-validation-for="Input.PermanentAddress"></span></div>
        </fieldset>
        <fieldset class="bm03-fields"><legend>Giấy tờ định danh</legend>
            <div><label asp-for="Input.DocumentKind"></label><select asp-for="Input.DocumentKind" asp-items="Html.GetEnumSelectList<IdentityDocumentKind>()"><option value="">Chưa bổ sung</option></select><span asp-validation-for="Input.DocumentKind"></span></div>
            <div><label asp-for="Input.DocumentNumber"></label><input asp-for="Input.DocumentNumber" autocomplete="off" /><span asp-validation-for="Input.DocumentNumber"></span></div>
            <div><label asp-for="Input.DocumentIssuedOn"></label><input asp-for="Input.DocumentIssuedOn" type="date" asp-format="{0:yyyy-MM-dd}" autocomplete="off" /><span asp-validation-for="Input.DocumentIssuedOn"></span></div>
            <div><label asp-for="Input.DocumentIssuedAt"></label><input asp-for="Input.DocumentIssuedAt" autocomplete="off" /><span asp-validation-for="Input.DocumentIssuedAt"></span></div>
        </fieldset>
        <div class="bm03-save-row"><button type="submit" class="rental-button primary" disabled="@Model.Conflict">Lưu và cập nhật bản nháp</button><p class="rental-note" data-draft-unsaved role="status">Chỉ nội dung đã lưu mới xuất hiện trên bản giấy bên dưới. Hồ sơ tài khoản không bị thay đổi.</p></div>
    </form>
</section>
