@{
    Layout = "_Layout";
    ViewData["Title"] = "Tài liệu hợp đồng vừa thay đổi";
    ViewData["Description"] = "Hãy đối chiếu phiên bản hiện tại trước khi xác nhận.";
}
<section class="rental-empty ez-rental-conflict-card">
    <div class="ez-rental-empty-icon is-amber" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
    </div>
    <h2>Cần xem lại bản hợp đồng mới</h2>
    <p>@ViewData["ConflictMessage"]</p>
    <div class="rental-actions">
        <a href="@ViewData["RecoveryUrl"]" class="rental-button primary">Mở lại hợp đồng</a>
    </div>
</section>
