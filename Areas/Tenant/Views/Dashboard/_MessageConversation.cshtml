@using EZ_Rent.Areas.Tenant.ViewModels
@model TenantMessagesModel
@if (Model.Selected is not { } selected)
{
    <div class="state-panel">@await Html.PartialAsync("_HomeIcon", "chat")<h2>Một nơi cho những cuộc trao đổi</h2><p>Chọn cuộc trò chuyện ở bên trái để xem nội dung. Bạn cũng có thể tìm phòng hoặc xem hướng dẫn hỗ trợ.</p><a asp-controller="RentalPost" asp-action="Index" class="button primary">Tìm phòng</a></div>
}
else
{
    <div class="chat-header"><a href="@Url.Action("Messages", Model.Input.Routes(conversationId: selected.Id, view: "inbox"))" data-messages-link class="icon-button mobile-back" aria-label="Về danh sách trò chuyện">@await Html.PartialAsync("_HomeIcon", "back")</a><span class="avatar @(selected.IsSupport ? "sage" : "")" aria-hidden="true">@selected.Initials</span><div class="chat-person"><h2 id="chat-person-name" tabindex="-1">@selected.Name</h2><p>@(selected.IsSupport ? "Bộ phận hỗ trợ EZ Rent" : "Chủ nhà · " + selected.RoomLabel)</p></div><button type="button" class="icon-button context-toggle" data-action="show-context" aria-label="Thông tin cuộc trò chuyện" aria-haspopup="dialog" aria-expanded="false" aria-controls="context-dialog">@await Html.PartialAsync("_HomeIcon", "info")</button></div>
    @if (selected.Room is { IsAvailable: true } room)
    {
        <button type="button" class="room-link" data-action="show-context" aria-haspopup="dialog" aria-controls="context-dialog"><img src="@room.ImageUrl" width="44" height="44" alt="" data-message-image /><span><strong>@room.Title</strong><small>@room.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ / tháng · @room.Area.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) m²</small></span>@await Html.PartialAsync("_HomeIcon", "arrow")</button>
    }
    @if (Model.Appointment is { } appointment)
    {
        <div class="visit-strip">@await Html.PartialAsync("_HomeIcon", "calendar")<span>Đã xác nhận <strong>@appointment.TimeLabel, @appointment.DateLabel</strong></span><a asp-controller="ViewingAppointment" asp-action="Details" asp-route-id="@appointment.Id">Xem lịch</a></div>
    }
    <div id="message-stream" class="message-stream" role="log" aria-live="off" aria-label="Nội dung trò chuyện với @selected.Name">
        @if (Model.MessagePages > 1)
        {
            <div class="history-pages"><p>Trang 1 là tin mới nhất.</p>@await Html.PartialAsync("_TenantPagination", new TenantPaginationModel(Model.Input.MessagePage, Model.MessagePages, page => Url.Action("Messages", Model.Input.Routes(conversationId: selected.Id, messagePage: page, view: "chat")), "Trang tin nhắn"))</div>
        }
        @{ DateTime? previousDate = null; }
        @foreach (var message in Model.Messages)
        {
            @if (previousDate != message.VietnamTime.Date) { <div class="date-divider">@message.DateLabel</div> }
            <div class="message @(message.Self ? "self" : "")" data-message-id="@message.Id"><p class="bubble">@message.Content</p><span class="message-meta"><time datetime="@message.VietnamTime.ToString("yyyy-MM-ddTHH:mm:ss+07:00")">@message.TimeLabel</time>@if (message.Self) { @await Html.PartialAsync("_HomeIcon", "check")<span>@(message.IsRead ? "Đã đọc" : "Đã gửi")</span> }</span></div>
            previousDate = message.VietnamTime.Date;
        }
        @if (Model.Messages.Count == 0) { <p class="stream-start">Cuộc trò chuyện này chưa có tin nhắn. Chức năng gửi đang được hoàn thiện.</p> }
    </div>
    <div class="composer"><div class="quick-replies" aria-label="Gợi ý bản nháp"><button type="button" data-quick="fees">Hỏi về phí dịch vụ</button><button type="button" data-quick="visit">Hỏi lịch xem phòng</button></div><label for="message-input" class="composer-label">Bản nháp tin nhắn</label><div class="compose-box"><textarea id="message-input" name="message-draft" rows="1" maxlength="2000" autocomplete="off" placeholder="Soạn bản nháp…" aria-describedby="send-availability"></textarea><button type="button" class="send-button" disabled aria-label="Gửi tin nhắn chưa khả dụng" aria-describedby="send-availability">@await Html.PartialAsync("_HomeIcon", "send")</button></div><div class="composer-bottom"><span id="send-availability">Chưa thể gửi · Bản nháp chỉ giữ trong tab này.</span><span id="message-char-count">0/2.000</span></div></div>
}
