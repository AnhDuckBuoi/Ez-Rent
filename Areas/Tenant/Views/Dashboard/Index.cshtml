@{
    ViewData["Title"] = "Dashboard Người thuê";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">🏡 Dashboard Người thuê</h2>
        <small class="text-muted">Xin chào, @User.Identity?.Name</small>
    </div>
    <a asp-area="" asp-controller="RentalPost" asp-action="Index"
       class="btn btn-success">
        🔍 Tìm phòng ngay
    </a>
</div>

<!-- ========== HÀNG 1: THỐNG KÊ CHÍNH ========== -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f093fb, #f5576c); color: white;">
            <div class="card-body">
                <div class="text-uppercase small opacity-75">❤️ Phòng yêu thích</div>
                <h2 class="mb-0 mt-1">@ViewBag.TotalFavorites</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body">
                <div class="text-uppercase small opacity-75">📅 Lịch hẹn sắp tới</div>
                <h2 class="mb-0 mt-1">@ViewBag.UpcomingViewings</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <div class="text-uppercase small opacity-75">📄 Hợp đồng active</div>
                <h2 class="mb-0 mt-1">@ViewBag.ActiveContracts</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-danger text-white">
            <div class="card-body">
                <div class="text-uppercase small opacity-75">💰 Hóa đơn chưa trả</div>
                <h2 class="mb-0 mt-1">@ViewBag.UnpaidInvoices</h2>
            </div>
        </div>
    </div>
</div>

<!-- ========== HÀNG 2: TIỀN + LỐI TẮT ========== -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm"
             style="background: linear-gradient(135deg, #ee0979, #ff6a00); color: white;">
            <div class="card-body">
                <div class="text-uppercase small opacity-75">💵 Cần thanh toán tháng @DateTime.Now.ToString("MM/yyyy")</div>
                <h2 class="mb-0 mt-2">@(((decimal)ViewBag.MonthDue).ToString("N0")) đ</h2>
                @if (ViewBag.OverdueInvoices > 0)
                {
                    <span class="badge bg-light text-danger mt-2">
                        ⚠️ Có @ViewBag.OverdueInvoices hóa đơn quá hạn!
                    </span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body">
                <h6>⚡ Lối tắt</h6>
                <div class="row g-2 mt-2">
                    <div class="col-6">
                        <a asp-area="Tenant" asp-controller="Favorite" asp-action="Index"
                           class="btn btn-outline-danger btn-sm w-100">❤️ Yêu thích</a>
                    </div>
                    <div class="col-6">
                        <a asp-area="Tenant" asp-controller="ViewingAppointment" asp-action="Index"
                           class="btn btn-outline-warning btn-sm w-100">📅 Lịch hẹn</a>
                    </div>
                    <div class="col-6">
                        <a asp-area="Tenant" asp-controller="Invoice" asp-action="Index"
                           class="btn btn-outline-primary btn-sm w-100">💰 Hóa đơn</a>
                    </div>
                    <div class="col-6">
                        <a asp-area="Tenant" asp-controller="RepairRequest" asp-action="Create"
                           class="btn btn-outline-info btn-sm w-100">🔧 Báo sự cố</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== CẢNH BÁO HỢP ĐỒNG SẮP HẾT HẠN ========== -->
@if (ViewBag.ExpiringContracts != null && ((List<RentalContract>)ViewBag.ExpiringContracts).Any())
{
    <div class="alert alert-warning mb-4">
        <h6>⚠️ Hợp đồng sắp hết hạn</h6>
        <ul class="mb-0">
            @foreach (var c in (List<RentalContract>)ViewBag.ExpiringContracts)
            {
                var days = (c.EndDate - DateTime.UtcNow).Days;
                <li>
                    <strong>@c.RentalPost?.Title</strong> —
                    còn <strong>@days ngày</strong> (hết hạn @c.EndDate.ToString("dd/MM/yyyy"))
                    <a asp-area="Tenant" asp-controller="Contract" asp-action="Details"
                       asp-route-id="@c.RentalContractId" class="btn btn-sm btn-outline-warning">
                        Xem
                    </a>
                </li>
            }
        </ul>
    </div>
}

<!-- ========== BẢNG DỮ LIỆU ========== -->
<div class="row g-4">
    <!-- HÓA ĐƠN CHƯA TRẢ -->
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">💰 Hóa đơn chưa thanh toán</h6>
                <a asp-area="Tenant" asp-controller="Invoice" asp-action="Index"
                   class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.UnpaidInvoiceList != null && ((List<Invoice>)ViewBag.UnpaidInvoiceList).Any())
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Phòng</th>
                                <th>Kỳ</th>
                                <th>Tổng tiền</th>
                                <th>Hạn trả</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in (List<Invoice>)ViewBag.UnpaidInvoiceList)
                            {
                                var overdue = inv.DueDate < DateTime.UtcNow;
                                <tr>
                                    <td>@inv.RentalContract?.RentalPost?.Title</td>
                                    <td>@inv.BillingPeriod</td>
                                    <td class="fw-bold text-danger">@inv.TotalAmount.ToString("N0") đ</td>
                                    <td>
                                        @if (overdue)
                                        {
                                            <span class="badge bg-danger">Quá hạn</span>
                                        }
                                        else
                                        {
                                            @inv.DueDate.ToString("dd/MM/yyyy")
                                        }
                                    </td>
                                    <td>
                                        <a asp-area="Tenant" asp-controller="Invoice" asp-action="Details"
                                           asp-route-id="@inv.InvoiceId"
                                           class="btn btn-sm btn-primary">Thanh toán</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted text-center py-4 mb-0">🎉 Không có hóa đơn nào cần thanh toán.</p>
                }
            </div>
        </div>
    </div>

    <!-- LỊCH HẸN -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">📅 Lịch hẹn của tôi</h6>
                <a asp-area="Tenant" asp-controller="ViewingAppointment" asp-action="Index"
                   class="btn btn-sm btn-outline-warning">Xem</a>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.RecentViewings != null && ((List<ViewingAppointment>)ViewBag.RecentViewings).Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var v in (List<ViewingAppointment>)ViewBag.RecentViewings)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <strong>@v.RentalPost?.Title</strong>
                                    @if (v.Status == ViewingAppointmentStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Chờ</span>
                                    }
                                    else if (v.Status == ViewingAppointmentStatus.Confirmed)
                                    {
                                        <span class="badge bg-success">Đã xác nhận</span>
                                    }
                                </div>
                                <small class="text-muted">
                                    🕐 @v.ViewingDate.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-4 mb-0">
                        Không có lịch hẹn nào.
                        <br />
                        <a asp-area="" asp-controller="RentalPost" asp-action="Index"
                           class="btn btn-sm btn-outline-success mt-2">🔍 Tìm phòng</a>
                    </p>
                }
            </div>
        </div>
    </div>
</div>