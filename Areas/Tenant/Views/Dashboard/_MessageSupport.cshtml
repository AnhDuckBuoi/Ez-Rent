@model EZ_Rent.Areas.Tenant.ViewModels.TenantMessagesModel
    <dialog id="support-dialog" class="support-dialog" aria-labelledby="support-title">
        <div class="dialog-heading"><div><span class="dialog-symbol">@await Html.PartialAsync("_HomeIcon", "support")</span><h2 id="support-title">Soạn yêu cầu hỗ trợ</h2><p>Nội dung dành cho bộ phận hỗ trợ EZ Rent.</p></div><button type="button" class="icon-button" data-action="close-support" aria-label="Đóng yêu cầu hỗ trợ">@await Html.PartialAsync("_HomeIcon", "close")</button></div>
        <p class="demo-disclosure">Chưa thể gửi trực tuyến. Bạn có thể soạn và xem trước nội dung trong tab này.</p>
        <form id="support-form" method="dialog" novalidate>
            <div class="form-pair"><div class="field"><label for="support-category">Vấn đề cần hỗ trợ</label><select id="support-category" name="category" required aria-describedby="support-category-error"><option value="">Chọn vấn đề</option><option>Thông tin phòng không đúng</option><option>Vấn đề khi xem phòng</option><option>Tài khoản và ứng dụng</option><option>Vấn đề khác</option></select><span class="field-error" id="support-category-error"></span></div><div class="field"><label for="support-room">Phòng liên quan</label><select id="support-room" name="room"><option value="none">Không liên quan đến phòng</option>@if (Model.Selected?.Room is { IsAvailable: true } room) { <option value="@room.RentalPostId">@room.Title</option> }</select></div></div>
            <div class="field"><label for="support-subject">Tiêu đề</label><input id="support-subject" name="subject" autocomplete="off" maxlength="100" required placeholder="Ví dụ: Cần làm rõ khoản phí dịch vụ" aria-describedby="support-subject-error"><span class="field-error" id="support-subject-error"></span></div>
            <div class="field"><label for="support-description">Mô tả chi tiết</label><textarea id="support-description" name="description" autocomplete="off" maxlength="1000" rows="5" required placeholder="Bạn đã gặp vấn đề gì và mong muốn được hỗ trợ như thế nào?" aria-describedby="support-description-error"></textarea><div class="field-bottom"><span class="field-error" id="support-description-error"></span><span id="support-char-count">0/1.000</span></div></div>
            <div class="dialog-actions"><button type="button" class="button" data-action="close-support">Để sau</button><button type="submit" class="button primary">Xem trước nội dung @await Html.PartialAsync("_HomeIcon", "arrow")</button></div>
        </form>
        <div id="support-result" hidden></div>
    </dialog>
