@using EZ_Rent.Data
@inject AppDbContext dbContext

@{
    ViewData["Title"] = "Quản lý Database";

    var canConnect = (bool)ViewBag.CanConnect;
    var dbName = ViewBag.DbName as string ?? "—";
    var dataSource = ViewBag.DataSource as string ?? "—";
    var provider = ViewBag.Provider as string ?? "—";

    var applied = ViewBag.AppliedMigrations as List<string> ?? new List<string>();
    var pending = ViewBag.PendingMigrations as List<string> ?? new List<string>();
    var counts = ViewBag.TableCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<partial name="_AdminMenu" />

<div class="ez-page-header mb-4">
    <div>
        <div class="ez-eyebrow">Hạ tầng dữ liệu</div>
        <h1 class="ez-page-title">Quản lý Database</h1>
        <p class="ez-page-subtitle">Kiểm tra kết nối cơ sở dữ liệu, theo dõi lịch sử migration và số lượng bản ghi.</p>
    </div>
</div>

<div class="alert alert-warning alert-dismissible fade show" role="alert">
    <strong>Lưu ý môi trường:</strong> Trang này dành cho môi trường phát triển. Các thao tác xóa cơ sở dữ liệu sẽ làm mất toàn bộ dữ liệu hiện tại.
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>

<div id="alertContainer">
    <partial name="_StatusMessage" />
</div>

<div class="card mb-4">
    <div class="card-header"><strong>Thông tin kết nối</strong></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Database</dt>
            <dd class="col-sm-9"><code>@dbName</code></dd>

            <dt class="col-sm-3 text-muted">Data Source</dt>
            <dd class="col-sm-9">@dataSource</dd>

            <dt class="col-sm-3 text-muted">Provider</dt>
            <dd class="col-sm-9">@provider</dd>

            <dt class="col-sm-3 text-muted">Trạng thái kết nối</dt>
            <dd class="col-sm-9">
                @if (canConnect)
                {
                    <span class="badge bg-success">Đã kết nối</span>
                }
                else
                {
                    <span class="badge bg-danger">Không kết nối được</span>
                }
            </dd>
        </dl>
    </div>
</div>

@if (canConnect)
{
    <div class="card mb-4">
        <div class="card-header"><strong>Số bản ghi trong các bảng chính</strong></div>
        <div class="card-body">
            <div class="row g-3">
                @foreach (var kv in counts)
                {
                    <div class="col-md-4 col-lg-2">
                        <div class="ez-kpi-card h-100">
                            <span class="ez-kpi-label">@kv.Key</span>
                            <div class="ez-kpi-value" style="font-size: 1.5rem;">@kv.Value</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Migrations</strong>
            @if (pending.Any())
            {
                <span class="badge bg-warning text-dark">@pending.Count migration đang chờ</span>
            }
            else
            {
                <span class="badge bg-success">Đã cập nhật</span>
            }
        </div>
        <div class="card-body">
            @if (!applied.Any() && !pending.Any())
            {
                <p class="text-muted mb-0">Chưa có migration nào.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var m in applied)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="font-monospace small">@m</span>
                            <span class="badge bg-light text-secondary border">Đã áp dụng</span>
                        </li>
                    }
                    @foreach (var m in pending)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-warning bg-opacity-10">
                            <span class="font-monospace small">@m</span>
                            <span class="badge bg-warning text-dark">Đang chờ</span>
                        </li>
                    }
                </ul>
            }

            @if (pending.Any())
            {
                <form asp-action="Migrate" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        Chạy migration (@pending.Count bản)
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="card border-danger mb-4">
        <div class="card-header bg-white text-danger border-bottom">
            <strong>Khu vực nguy hiểm (Danger Zone)</strong>
        </div>
        <div class="card-body">
            <h6 class="text-danger fw-bold">Xóa toàn bộ Database</h6>
            <p class="text-muted small mb-3">
                Hành động này sẽ <strong>xóa toàn bộ database</strong> và <strong>không thể hoàn tác</strong>.
                Mọi dữ liệu (users, posts, contracts, invoices, ...) sẽ bị mất vĩnh viễn.
            </p>
            <a asp-action="DeleteDb" class="btn btn-outline-danger">
                Xóa Database: @dbName
            </a>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        <strong>Không thể kết nối tới Database.</strong>
        Vui lòng kiểm tra connection string hoặc chạy migration để tạo database.
    </div>
}
