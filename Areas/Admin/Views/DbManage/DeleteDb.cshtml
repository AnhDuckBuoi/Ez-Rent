@{
    ViewData["Title"] = "Xóa Database";
    var dbName = ViewBag.DbName as string ?? "";
}

<partial name="_AdminMenu" />

<div class="ez-page-header mb-4">
    <div>
        <span class="ez-eyebrow">Hạ tầng dữ liệu</span>
        <h1 class="ez-page-title">Xóa Database</h1>
    </div>
</div>

<div class="card border-danger">
    <div class="card-header text-danger">
        <strong>Cảnh báo thao tác nguy hiểm</strong>
    </div>
    <div class="card-body">

        <div class="alert alert-danger mb-4">
            <h5 class="mb-2">Bạn đang chuẩn bị xóa database:</h5>
            <p class="fs-4 mb-3">
                <code class="text-danger">@dbName</code>
            </p>
            <p class="mb-2"><strong>Hành động này sẽ:</strong></p>
            <ul class="mb-0 small">
                <li>Xóa toàn bộ tài khoản người dùng (Landlord, Tenant, Admin)</li>
                <li>Xóa toàn bộ bài đăng, hợp đồng, hóa đơn</li>
                <li>Xóa toàn bộ khiếu nại, thông báo, tin nhắn</li>
                <li><strong>Không thể hoàn tác</strong></li>
            </ul>
        </div>

        <form asp-action="DeleteDbAsync" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label for="confirmName" class="form-label">
                    Để xác nhận, vui lòng nhập chính xác tên database:
                    <code class="text-danger">@dbName</code>
                </label>
                <input type="text"
                       id="confirmName"
                       name="confirmName"
                       class="form-control"
                       placeholder="Nhập tên database..."
                       autocomplete="off"
                       required />
            </div>

            <div class="d-flex gap-2">
                <button type="submit"
                        class="btn btn-danger"
                        id="btnDelete"
                        disabled>
                    Xóa vĩnh viễn
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    ← Quay lại
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('confirmName');
            const btn = document.getElementById('btnDelete');
            const expected = '@dbName';

            input.addEventListener('input', function () {
                const match = input.value.trim().toLowerCase() === expected.toLowerCase();
                btn.disabled = !match;
            });

            btn.addEventListener('click', function (e) {
                if (!confirm(`XÓA VĨNH VIỄN database "${expected}"?\n\nHành động này KHÔNG THỂ HOÀN TÁC!`)) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
