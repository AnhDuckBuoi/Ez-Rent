@using EZ_Rent.Models.Enums
@{
    ViewData["Title"] = "Dashboard Quản trị";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">📊 Dashboard Quản trị</h2>
        <small class="text-muted">Tổng quan hệ thống EZ-Rent — @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
    </div>
    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        🔄 Làm mới
    </a>
</div>

<!-- ========== HÀNG 1: NGƯỜI DÙNG ========== -->
<h6 class="text-uppercase text-muted mb-2">👥 Người dùng</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #667eea, #764ba2); color: white;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-uppercase small opacity-75">Tổng người dùng</div>
                        <h2 class="mb-0 mt-1">@ViewBag.TotalUsers</h2>
                    </div>
                    <div class="fs-1 opacity-50">👥</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f093fb, #f5576c); color: white;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-uppercase small opacity-75">Chủ trọ</div>
                        <h2 class="mb-0 mt-1">@ViewBag.TotalLandlords</h2>
                    </div>
                    <div class="fs-1 opacity-50">🏠</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #4facfe, #00f2fe); color: white;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-uppercase small opacity-75">Người thuê</div>
                        <h2 class="mb-0 mt-1">@ViewBag.TotalTenants</h2>
                    </div>
                    <div class="fs-1 opacity-50">🏡</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-secondary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-uppercase small opacity-75">Tài khoản bị khóa</div>
                        <h2 class="mb-0 mt-1">@ViewBag.LockedUsers</h2>
                    </div>
                    <div class="fs-1 opacity-50">🔒</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== HÀNG 2: TIN ĐĂNG ========== -->
<h6 class="text-uppercase text-muted mb-2">📝 Tin đăng</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small">Tổng tin đăng</div>
                <h3 class="mb-0">@ViewBag.TotalPosts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm border-start border-warning border-4">
            <div class="card-body">
                <div class="text-muted small">⏳ Chờ duyệt</div>
                <h3 class="mb-0 text-warning">@ViewBag.PendingPosts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm border-start border-success border-4">
            <div class="card-body">
                <div class="text-muted small">✅ Đã duyệt</div>
                <h3 class="mb-0 text-success">@ViewBag.ApprovedPosts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm border-start border-danger border-4">
            <div class="card-body">
                <div class="text-muted small">❌ Từ chối</div>
                <h3 class="mb-0 text-danger">@ViewBag.RejectedPosts</h3>
            </div>
        </div>
    </div>
</div>

<!-- ========== HÀNG 3: HỢP ĐỒNG + SỰ CỐ ========== -->
<h6 class="text-uppercase text-muted mb-2">📄 Hợp đồng & Sự cố</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <div class="text-uppercase small opacity-75">Tổng hợp đồng</div>
                <h3 class="mb-0">@ViewBag.TotalContracts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <div class="text-uppercase small opacity-75">Hợp đồng active</div>
                <h3 class="mb-0">@ViewBag.ActiveContracts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body">
                <div class="text-uppercase small opacity-75">Sự cố mở</div>
                <h3 class="mb-0">@ViewBag.OpenRepairs</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-danger text-white">
            <div class="card-body">
                <div class="text-uppercase small opacity-75">🚨 Khẩn cấp</div>
                <h3 class="mb-0">@ViewBag.UrgentRepairs</h3>
            </div>
        </div>
    </div>
</div>

<!-- ========== LỐI TẮT ========== -->
<h6 class="text-uppercase text-muted mb-2">⚡ Lối tắt</h6>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="Post" asp-action="Index"
           class="card border-0 shadow-sm text-decoration-none h-100">
            <div class="card-body text-center py-3">
                <div class="fs-1">📝</div>
                <div class="fw-bold mt-2 text-dark">Kiểm duyệt tin</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="UserManager" asp-action="Index"
           class="card border-0 shadow-sm text-decoration-none h-100">
            <div class="card-body text-center py-3">
                <div class="fs-1">👥</div>
                <div class="fw-bold mt-2 text-dark">Quản lý user</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="RoleManager" asp-action="Index"
           class="card border-0 shadow-sm text-decoration-none h-100">
            <div class="card-body text-center py-3">
                <div class="fs-1">🎭</div>
                <div class="fw-bold mt-2 text-dark">Quản lý role</div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="Support" asp-action="Index"
           class="card border-0 shadow-sm text-decoration-none h-100">
            <div class="card-body text-center py-3">
                <div class="fs-1">💬</div>
                <div class="fw-bold mt-2 text-dark">Hỗ trợ</div>
            </div>
        </a>
    </div>
</div>

<!-- ========== BẢNG: TIN CHỜ DUYỆT ========== -->
<div class="row g-4">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">⏳ Tin đăng chờ duyệt</h6>
                <a asp-area="Admin" asp-controller="Post" asp-action="Index"
                   class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.RecentPendingPosts != null && ((List<RentalPost>)ViewBag.RecentPendingPosts).Any())
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tiêu đề</th>
                                <th>Chủ trọ</th>
                                <th>Giá</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in (List<RentalPost>)ViewBag.RecentPendingPosts)
                            {
                                <tr>
                                    <td class="text-truncate" style="max-width: 250px;">@post.Title</td>
                                    <td>@post.Owner?.FullName</td>
                                    <td class="text-primary fw-bold">@post.Price.ToString("N0") đ</td>
                                    <td>
                                        <a asp-area="Admin" asp-controller="Post" asp-action="Details"
                                           asp-route-id="@post.RentalPostId"
                                           class="btn btn-sm btn-primary">Xem</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted text-center py-4 mb-0">✅ Không có tin nào đang chờ duyệt.</p>
                }
            </div>
        </div>
    </div>

    <!-- ========== BẢNG: SỰ CỐ ========== -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0">🔧 Sự cố cần xử lý</h6>
                <a asp-area="Admin" asp-controller="Support" asp-action="Index"
                   class="btn btn-sm btn-outline-danger">Xem</a>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.RecentRepairs != null && ((List<RepairRequest>)ViewBag.RecentRepairs).Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var repair in (List<RepairRequest>)ViewBag.RecentRepairs)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <strong>@repair.ProblemType</strong>
                                    @if (repair.Priority == RepairPriority.Urgent)
                                    {
                                        <span class="badge bg-danger">Khẩn</span>
                                    }
                                    else if (repair.Priority == RepairPriority.High)
                                    {
                                        <span class="badge bg-warning text-dark">Cao</span>
                                    }
                                </div>
                                <small class="text-muted">
                                    @repair.RentalPost?.Title — @repair.Tenant?.FullName
                                </small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-4 mb-0">✅ Không có sự cố nào.</p>
                }
            </div>
        </div>
    </div>
</div>