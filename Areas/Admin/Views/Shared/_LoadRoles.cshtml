@if ( ViewBag.CurrentRoles != null)
        {
            <dt class="col-sm-2">
                Roles:
            </dt>

            <dd class="col-sm-10">
                @foreach (var role in ViewBag.currentRoles)
                {
                    <span class="badge bg-primary me-1">
                        @role
                    </span>
                }
            </dd>
        }