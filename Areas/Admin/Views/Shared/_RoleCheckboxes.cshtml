@{
    var roles = ViewBag.Roles as IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
                 ?? Enumerable.Empty<Microsoft.AspNetCore.Identity.IdentityRole>();

    var selectedRoles = ViewBag.SelectedRoles as IEnumerable<string>
                        ?? Enumerable.Empty<string>();

    var selectedRoleNames = selectedRoles
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Select(x => x.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
}

@foreach (var role in roles)
{
    var isSelected = role.Name != null &&
                     selectedRoleNames.Contains(role.Name.Trim());

    <div class="form-check">
        <input class="form-check-input"
               type="checkbox"
               name="roles"
               value="@role.Name"
               id="role_@role.Id"
               @(isSelected ? "checked" : "") />

        <label class="form-check-label"
               for="role_@role.Id">
            @role.Name
        </label>
    </div>
}