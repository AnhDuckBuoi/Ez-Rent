@model EZ_Rent.Models.RepairRequest
@using EZ_Rent.Models.Enums

@{
    ViewData["Title"] = "Chi tiết khiếu nại";

    // Nhớ trang trước đó (nếu có)
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var backUrl = string.IsNullOrEmpty(returnUrl)
        ? Url.Action("Index", "Support", new { area = "Admin" })
        : returnUrl;
}

<partial name="_AdminMenu" />

<div class="ez-page-header mb-3">
    <div>
        <span class="ez-eyebrow">Hỗ trợ & Bảo trì</span>
        <h1 class="ez-page-title">Chi tiết khiếu nại</h1>
    </div>
</div>

<div id="alertContainer">
    <partial name="_StatusMessage" />
</div>

@* ============================================================ *@
@*  KHU VỰC HÀNH ĐỘNG                                            *@
@* ============================================================ *@
<div class="mb-3" id="actionBar">
    <a href="@backUrl" class="btn btn-outline-secondary">← Quay lại danh sách</a>

    @if (Model.Status == RepairRequestStatus.Pending)
    {
        <button type="button" class="btn btn-info btn-action" data-id="@Model.RepairRequestId" data-action="InProgress">
            Bắt đầu xử lý
        </button>

        <button type="button" class="btn btn-success btn-resolve" data-id="@Model.RepairRequestId">
            Đánh dấu đã giải quyết
        </button>

        <button type="button" class="btn btn-outline-danger btn-cancel" data-id="@Model.RepairRequestId">
            Hủy khiếu nại
        </button>
    }

    @if (Model.Status == RepairRequestStatus.InProgress)
    {
        <button type="button" class="btn btn-success btn-resolve" data-id="@Model.RepairRequestId">
            Đánh dấu đã giải quyết
        </button>

        <button type="button" class="btn btn-outline-danger btn-cancel" data-id="@Model.RepairRequestId">
            Hủy khiếu nại
        </button>
    }

    @if (Model.Status == RepairRequestStatus.Resolved)
    {
        <div class="alert alert-success mb-0 d-inline-block">
            Khiếu nại đã được giải quyết
            @if (Model.ResolvedAt.HasValue)
            {
                <span> — @Model.ResolvedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
            }
        </div>
    }

    @if (Model.Status == RepairRequestStatus.Cancelled)
    {
        <div class="alert alert-secondary mb-0 d-inline-block">
            Khiếu nại đã bị hủy
        </div>
    }
</div>

@* ============================================================ *@
@*  THÔNG TIN KHIẾU NẠI                                            *@
@* ============================================================ *@
<div class="row">
    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header"><strong>Nội dung khiếu nại</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Loại sự cố</dt>
                    <dd class="col-sm-8">@Model.ProblemType</dd>

                    <dt class="col-sm-4">Mức độ ưu tiên</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Priority)
                        {
                            case RepairPriority.Low:
                                <span class="badge bg-secondary">Thấp</span>
                                break;
                            case RepairPriority.Medium:
                                <span class="badge bg-info text-dark">Trung bình</span>
                                break;
                            case RepairPriority.High:
                                <span class="badge bg-warning text-dark">Cao</span>
                                break;
                            case RepairPriority.Urgent:
                                <span class="badge bg-danger">Khẩn cấp</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8 status-cell">
                        @switch (Model.Status)
                        {
                            case RepairRequestStatus.Pending:
                                <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                break;
                            case RepairRequestStatus.InProgress:
                                <span class="badge bg-info text-dark">Đang xử lý</span>
                                break;
                            case RepairRequestStatus.Resolved:
                                <span class="badge bg-success">Đã giải quyết</span>
                                break;
                            case RepairRequestStatus.Cancelled:
                                <span class="badge bg-secondary">Đã hủy</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Mô tả</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4">Ngày gửi</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dt class="col-sm-4">Cập nhật lúc</dt>
                        <dd class="col-sm-8">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                    }

                    @if (Model.ResolvedAt.HasValue)
                    {
                        <dt class="col-sm-4">Giải quyết lúc</dt>
                        <dd class="col-sm-8">@Model.ResolvedAt.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.ResolutionNote))
                    {
                        <dt class="col-sm-4">Ghi chú giải quyết</dt>
                        <dd class="col-sm-8">@Model.ResolutionNote</dd>
                    }
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="card mb-3">
                <div class="card-header"><strong>Ảnh đính kèm</strong></div>
                <div class="card-body">
                    <img src="@Model.ImageUrl" class="img-fluid rounded" alt="Ảnh khiếu nại" />
                </div>
            </div>
        }
    </div>

    <div class="col-md-5">
        @{
            var tenantInitial = !string.IsNullOrEmpty(Model.Tenant?.FullName)
                ? Model.Tenant.FullName.Trim().First().ToString().ToUpper()
                : "?";
        }

        <div class="d-flex align-items-center gap-2">
            @* ⭐ AVATAR dạng chữ cái đầu *@
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:46px; height:46px;
                background: var(--ez-blue, #356797);
                color:white; font-size:20px; font-weight:bold;">
                @tenantInitial
            </div>
            <div>
                <p class="mb-0"><strong>@Model.Tenant?.FullName</strong></p>
                <p class="text-muted small mb-0">@Model.Tenant?.Email</p>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><strong>Phòng</strong></div>
            <div class="card-body">
                <p class="mb-1 fw-bold">@Model.RentalPost?.Title</p>
                <p class="text-muted small mb-2">@Model.RentalPost?.Address</p>
                @if (Model.RentalPost != null)
                {
                    @* ⭐ ĐÃ FIX: Link sang Admin/Post/Details (không nhảy ra public) *@
                    <a asp-area="Admin" asp-controller="Post" asp-action="Details"
                       asp-route-id="@Model.RentalPost.RentalPostId" class="btn btn-sm btn-outline-primary">
                        Xem tin đăng
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@* ============================================================ *@
@*  MODAL RESOLVE                                                *@
@* ============================================================ *@
<div class="modal fade" id="resolveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Đánh dấu đã giải quyết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="resolveId" />
                <label for="resolveNote" class="form-label">
                    Ghi chú giải quyết <span class="text-danger">*</span>
                </label>
                <textarea id="resolveNote" class="form-control" rows="3" required maxlength="2000"
                          placeholder="VD: Đã cử thợ sửa, kiểm tra lại và hoạt động bình thường..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="btnConfirmResolve">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@* ============================================================ *@
@*  MODAL CANCEL                                                 *@
@* ============================================================ *@
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Hủy khiếu nại</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cancelId" />
                <label for="cancelNote" class="form-label">
                    Lý do hủy <span class="text-danger">*</span>
                </label>
                <textarea id="cancelNote" class="form-control" rows="3" required maxlength="2000"
                          placeholder="VD: Khiếu nại trùng lặp, không có căn cứ..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="btnConfirmCancel">Xác nhận hủy</button>
            </div>
        </div>
    </div>
</div>

@* Form ẩn — chứa AntiForgeryToken cho AJAX *@
<form id="afForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const afInput = document.querySelector('#afForm input[name="__RequestVerificationToken"]');
            const AF_TOKEN = afInput ? afInput.value : '';

            const alertContainer = document.getElementById('alertContainer');

            // ================= Alert =================
            function showAlert(message, type = 'warning') {
                const html = `
                        <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                            ${message}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>`;
                alertContainer.insertAdjacentHTML('afterbegin', html);

                setTimeout(() => {
                    const first = alertContainer.querySelector('.alert');
                    if (first) bootstrap.Alert.getOrCreateInstance(first).close();
                }, 4000);
            }

            // ================= POST helper =================
            async function postAction(url, params = {}) {
                const body = new URLSearchParams({
                    __RequestVerificationToken: AF_TOKEN,
                    ...params
                });

                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return await res.json();
            }

            // ================= RENDER STATUS =================
            function renderStatusBadge(status) {
                switch (status) {
                    case 'Pending':
                        return '<span class="badge bg-warning text-dark">Chờ xử lý</span>';
                    case 'InProgress':
                        return '<span class="badge bg-info text-dark">Đang xử lý</span>';
                    case 'Resolved':
                        return '<span class="badge bg-success">Đã giải quyết</span>';
                    case 'Cancelled':
                        return '<span class="badge bg-secondary">Đã hủy</span>';
                    default:
                        return status;
                }
            }

            // ================= UPDATE UI =================
            function updateUI(id, newStatus, note) {
                // 1. Cập nhật badge trạng thái trong card thông tin
                const statusCell = document.querySelector('.status-cell');
                if (statusCell) statusCell.innerHTML = renderStatusBadge(newStatus);

                // 2. Cập nhật lại action bar
                const actionBar = document.getElementById('actionBar');
                const backBtn = `<a href="@backUrl" class="btn btn-outline-secondary">← Quay lại danh sách</a>`;

                let actionsHtml = backBtn;

                if (newStatus === 'InProgress') {
                    actionsHtml += `
                            <button type="button" class="btn btn-success btn-resolve" data-id="${id}">
                                Đánh dấu đã giải quyết
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-cancel" data-id="${id}">
                                Hủy khiếu nại
                            </button>`;
                } else if (newStatus === 'Resolved') {
                    actionsHtml += `<div class="alert alert-success mb-0 d-inline-block">
                            Khiếu nại đã được giải quyết
                        </div>`;
                } else if (newStatus === 'Cancelled') {
                    actionsHtml += `<div class="alert alert-secondary mb-0 d-inline-block">
                            Khiếu nại đã bị hủy
                        </div>`;
                }

                actionBar.innerHTML = actionsHtml;

                // 3. Nếu có note → thêm dòng "Ghi chú giải quyết" / "Lý do hủy"
                if (note) {
                    const dl = document.querySelector('.card-body dl');
                    if (dl && !dl.querySelector('.resolution-note-row')) {
                        const dt = document.createElement('dt');
                        dt.className = 'col-sm-4 resolution-note-row';
                        dt.textContent = newStatus === 'Resolved' ? 'Ghi chú giải quyết' : 'Lý do hủy';

                        const dd = document.createElement('dd');
                        dd.className = 'col-sm-8 resolution-note-row';
                        dd.textContent = note;

                        dl.appendChild(dt);
                        dl.appendChild(dd);
                    }
                }

                // 4. Rebind events
                bindEvents();
            }

            // ================= IN PROGRESS =================
            async function doInProgress(id, btn) {
                if (!confirm('Chuyển khiếu nại sang trạng thái Đang xử lý?')) return;

                btn.disabled = true;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '...';

                try {
                    const data = await postAction(`/Admin/Support/InProgress/${id}`);

                    if (data.success) {
                        updateUI(id, data.newStatus, null);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }

            // ================= RESOLVE =================
            function openResolveModal(id) {
                document.getElementById('resolveId').value = id;
                document.getElementById('resolveNote').value = '';
                new bootstrap.Modal(document.getElementById('resolveModal')).show();
            }

            async function submitResolve() {
                const id = document.getElementById('resolveId').value;
                const note = document.getElementById('resolveNote').value.trim();

                if (!note) {
                    showAlert('Vui lòng nhập ghi chú giải quyết', 'warning');
                    return;
                }

                const btn = document.getElementById('btnConfirmResolve');
                btn.disabled = true;
                btn.innerHTML = 'Đang xử lý...';

                try {
                    const data = await postAction(`/Admin/Support/Resolve/${id}`, { note });

                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('resolveModal')).hide();
                        updateUI(id, data.newStatus, note);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = 'Xác nhận';
                }
            }

            // ================= CANCEL =================
            function openCancelModal(id) {
                document.getElementById('cancelId').value = id;
                document.getElementById('cancelNote').value = '';
                new bootstrap.Modal(document.getElementById('cancelModal')).show();
            }

            async function submitCancel() {
                const id = document.getElementById('cancelId').value;
                const note = document.getElementById('cancelNote').value.trim();

                if (!note) {
                    showAlert('Vui lòng nhập lý do hủy', 'warning');
                    return;
                }

                const btn = document.getElementById('btnConfirmCancel');
                btn.disabled = true;
                btn.innerHTML = 'Đang xử lý...';

                try {
                    const data = await postAction(`/Admin/Support/Cancel/${id}`, { note });

                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('cancelModal')).hide();
                        updateUI(id, data.newStatus, note);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = 'Xác nhận hủy';
                }
            }

            // ================= BIND EVENTS =================
            function bindEvents() {
                document.querySelectorAll('.btn-action').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        doInProgress(btn.dataset.id, btn);
                    });
                });

                document.querySelectorAll('.btn-resolve').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        openResolveModal(btn.dataset.id);
                    });
                });

                document.querySelectorAll('.btn-cancel').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        openCancelModal(btn.dataset.id);
                    });
                });
            }

            bindEvents();

            // Modal confirm buttons
            document.getElementById('btnConfirmResolve')?.addEventListener('click', submitResolve);
            document.getElementById('btnConfirmCancel')?.addEventListener('click', submitCancel);
        });
    </script>
}