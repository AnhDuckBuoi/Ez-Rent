@using EZ_Rent.Helpers
@model PaginatedList<EZ_Rent.Models.RepairRequest>
@using EZ_Rent.Models.Enums

@{
    ViewData["Title"] = "Khiếu nại sửa chữa";
}

<partial name="_AdminMenu" />

<div class="ez-page-header mb-4">
    <div>
        <div class="ez-eyebrow">Hỗ trợ & Bảo trì</div>
        <h1 class="ez-page-title">Khiếu nại sửa chữa</h1>
        <p class="ez-page-subtitle">Theo dõi và xử lý các yêu cầu sửa chữa, bảo trì phòng trọ từ người thuê.</p>
    </div>
</div>

<div id="alertContainer">
    <partial name="_StatusMessage" />
</div>

<ul class="nav nav-pills mb-3 gap-1">
    <li class="nav-item">
        <a class="nav-link @(ViewBag.StatusFilter == null ? "active" : "")"
           asp-action="Index">Tất cả</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewBag.StatusFilter == "Pending" ? "active" : "")"
           asp-action="Index" asp-route-status="Pending">Chờ xử lý</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewBag.StatusFilter == "InProgress" ? "active" : "")"
           asp-action="Index" asp-route-status="InProgress">Đang xử lý</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewBag.StatusFilter == "Resolved" ? "active" : "")"
           asp-action="Index" asp-route-status="Resolved">Đã giải quyết</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewBag.StatusFilter == "Cancelled" ? "active" : "")"
           asp-action="Index" asp-route-status="Cancelled">Đã hủy</a>
    </li>
</ul>

<p class="text-muted small mb-3">
    Tổng <strong>@Model.TotalItems</strong> khiếu nại ·
    Trang <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong>
</p>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Phòng</th>
                    <th>Người gửi</th>
                    <th>Loại sự cố</th>
                    <th>Ưu tiên</th>
                    <th>Trạng thái</th>
                    <th>Ngày gửi</th>
                    <th style="width:280px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr id="repair-row-@item.RepairRequestId" data-id="@item.RepairRequestId">
                        <td class="text-truncate" style="max-width:200px;">
                            @item.RentalPost?.Address
                        </td>
                        <td>@item.Tenant?.FullName</td>
                        <td>@item.ProblemType</td>

                        <td class="priority-cell">
                            @switch (item.Priority)
                            {
                                case RepairPriority.Low:
                                    <span class="badge bg-secondary">Thấp</span>
                                    break;
                                case RepairPriority.Medium:
                                    <span class="badge bg-info text-dark">Trung bình</span>
                                    break;
                                case RepairPriority.High:
                                    <span class="badge bg-warning text-dark">Cao</span>
                                    break;
                                case RepairPriority.Urgent:
                                    <span class="badge bg-danger">Khẩn cấp</span>
                                    break;
                            }
                        </td>

                        <td class="status-cell">
                            @switch (item.Status)
                            {
                                case RepairRequestStatus.Pending:
                                    <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                    break;
                                case RepairRequestStatus.InProgress:
                                    <span class="badge bg-info text-dark">Đang xử lý</span>
                                    break;
                                case RepairRequestStatus.Resolved:
                                    <span class="badge bg-success">Đã giải quyết</span>
                                    break;
                                case RepairRequestStatus.Cancelled:
                                    <span class="badge bg-secondary">Đã hủy</span>
                                    break;
                            }
                        </td>

                        <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                        <td class="action-cell">
                            <a asp-action="Details" asp-route-id="@item.RepairRequestId"
                               class="btn btn-sm btn-outline-primary">Chi tiết</a>

                            @if (item.Status == RepairRequestStatus.Pending)
                            {
                                <button type="button" class="btn btn-sm btn-info btn-action"
                                        data-id="@item.RepairRequestId"
                                        data-action="InProgress">
                                    Bắt đầu
                                </button>

                                <button type="button" class="btn btn-sm btn-success btn-resolve"
                                        data-id="@item.RepairRequestId">
                                    Xử lý
                                </button>

                                <button type="button" class="btn btn-sm btn-outline-danger btn-cancel"
                                        data-id="@item.RepairRequestId">
                                    Hủy
                                </button>
                            }
                            else if (item.Status == RepairRequestStatus.InProgress)
                            {
                                <button type="button" class="btn btn-sm btn-success btn-resolve"
                                        data-id="@item.RepairRequestId">
                                    Xử lý
                                </button>

                                <button type="button" class="btn btn-sm btn-outline-danger btn-cancel"
                                        data-id="@item.RepairRequestId">
                                    Hủy
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@{
    var routeValues = new Dictionary<string, string?>
    {
        ["status"] = ViewBag.StatusFilter
    };
}

<div class="mt-3">
    @await Html.PartialAsync("_Pagination", PaginationInfo.From(
        Model,
        action: "Index",
        controller: "Support",
        area: "Admin",
        routeValues: routeValues))
</div>

<div class="modal fade" id="resolveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Đánh dấu đã giải quyết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="resolveId" />
                <label for="resolveNote" class="form-label">
                    Ghi chú giải quyết <span class="text-danger">*</span>
                </label>
                <textarea id="resolveNote" class="form-control" rows="3" required maxlength="2000"
                          placeholder="VD: Đã cử thợ sửa, kiểm tra lại và hoạt động bình thường..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="btnConfirmResolve">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Hủy khiếu nại</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cancelId" />
                <label for="cancelNote" class="form-label">
                    Lý do hủy <span class="text-danger">*</span>
                </label>
                <textarea id="cancelNote" class="form-control" rows="3" required maxlength="2000"
                          placeholder="VD: Khiếu nại trùng lặp, không có căn cứ..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="btnConfirmCancel">Xác nhận hủy</button>
            </div>
        </div>
    </div>
</div>

<form id="afForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const afInput = document.querySelector('#afForm input[name="__RequestVerificationToken"]');
            const AF_TOKEN = afInput ? afInput.value : '';

            const alertContainer = document.getElementById('alertContainer');

            function showAlert(message, type = 'warning') {
                const html = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                alertContainer.insertAdjacentHTML('afterbegin', html);

                setTimeout(() => {
                    const first = alertContainer.querySelector('.alert');
                    if (first) bootstrap.Alert.getOrCreateInstance(first).close();
                }, 4000);
            }

            async function postAction(url, params = {}) {
                const body = new URLSearchParams({
                    __RequestVerificationToken: AF_TOKEN,
                    ...params
                });

                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return await res.json();
            }

            function renderStatusBadge(status) {
                switch (status) {
                    case 'Pending':
                        return '<span class="badge bg-warning text-dark">Chờ xử lý</span>';
                    case 'InProgress':
                        return '<span class="badge bg-info text-dark">Đang xử lý</span>';
                    case 'Resolved':
                        return '<span class="badge bg-success">Đã giải quyết</span>';
                    case 'Cancelled':
                        return '<span class="badge bg-secondary">Đã hủy</span>';
                    default:
                        return status;
                }
            }

            function renderActions(id, status) {
                const details = `<a href="/Admin/Support/Details/${id}" class="btn btn-sm btn-outline-primary">Chi tiết</a>`;

                if (status === 'Pending') {
                    return `
                        ${details}
                        <button type="button" class="btn btn-sm btn-info btn-action"
                                data-id="${id}" data-action="InProgress">Bắt đầu</button>
                        <button type="button" class="btn btn-sm btn-success btn-resolve"
                                data-id="${id}">Xử lý</button>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-cancel"
                                data-id="${id}">Hủy</button>`;
                }

                if (status === 'InProgress') {
                    return `
                        ${details}
                        <button type="button" class="btn btn-sm btn-success btn-resolve"
                                data-id="${id}">Xử lý</button>
                        <button type="button" class="btn btn-sm btn-outline-danger btn-cancel"
                                data-id="${id}">Hủy</button>`;
                }

                return details;
            }

            function updateRow(id, newStatus) {
                const row = document.getElementById(`repair-row-${id}`);
                if (!row) return;

                row.querySelector('.status-cell').innerHTML = renderStatusBadge(newStatus);
                row.querySelector('.action-cell').innerHTML = renderActions(id, newStatus);

                bindRowEvents();
            }

            async function doInProgress(id, btn) {
                if (!confirm('Chuyển khiếu nại sang trạng thái Đang xử lý?')) return;

                btn.disabled = true;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = 'Đang xử lý...';

                try {
                    const data = await postAction(`/Admin/Support/InProgress/${id}`);

                    if (data.success) {
                        updateRow(id, data.newStatus);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }

            function openResolveModal(id) {
                document.getElementById('resolveId').value = id;
                document.getElementById('resolveNote').value = '';
                new bootstrap.Modal(document.getElementById('resolveModal')).show();
            }

            async function submitResolve() {
                const id = document.getElementById('resolveId').value;
                const note = document.getElementById('resolveNote').value.trim();

                if (!note) {
                    showAlert('Vui lòng nhập ghi chú giải quyết', 'warning');
                    return;
                }

                const btn = document.getElementById('btnConfirmResolve');
                btn.disabled = true;
                btn.innerHTML = 'Đang xử lý...';

                try {
                    const data = await postAction(`/Admin/Support/Resolve/${id}`, { note });

                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('resolveModal')).hide();
                        updateRow(id, data.newStatus);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = 'Xác nhận';
                }
            }

            function openCancelModal(id) {
                document.getElementById('cancelId').value = id;
                document.getElementById('cancelNote').value = '';
                new bootstrap.Modal(document.getElementById('cancelModal')).show();
            }

            async function submitCancel() {
                const id = document.getElementById('cancelId').value;
                const note = document.getElementById('cancelNote').value.trim();

                if (!note) {
                    showAlert('Vui lòng nhập lý do hủy', 'warning');
                    return;
                }

                const btn = document.getElementById('btnConfirmCancel');
                btn.disabled = true;
                btn.innerHTML = 'Đang xử lý...';

                try {
                    const data = await postAction(`/Admin/Support/Cancel/${id}`, { note });

                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('cancelModal')).hide();
                        updateRow(id, data.newStatus);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = 'Xác nhận hủy';
                }
            }

            function bindRowEvents() {
                document.querySelectorAll('.btn-action').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        doInProgress(btn.dataset.id, btn);
                    });
                });

                document.querySelectorAll('.btn-resolve').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        openResolveModal(btn.dataset.id);
                    });
                });

                document.querySelectorAll('.btn-cancel').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        openCancelModal(btn.dataset.id);
                    });
                });
            }

            bindRowEvents();

            document.getElementById('btnConfirmResolve')?.addEventListener('click', submitResolve);
            document.getElementById('btnConfirmCancel')?.addEventListener('click', submitCancel);
        });
    </script>
}
