@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Role Manager";
}

<h1>Role Manager</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create Role
    </a>
</p>

<partial name="_StatusMessage" />

<table class="table">
    <thead>
        <tr>
            <th>Role Name</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
            </tr>
        }
    </tbody>
</table>