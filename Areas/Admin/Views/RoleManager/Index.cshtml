@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Quản lý Role";
    var roleUserCounts = ViewBag.RoleUserCounts as Dictionary<string, int>
                         ?? new Dictionary<string, int>();

    var protectedRoles = new[] { "Admin", "Landlord", "Tenant" };
}

<partial name="_AdminMenu" />

<div class="ez-page-header mb-4">
    <div>
        <div class="ez-eyebrow">Phân quyền hệ thống</div>
        <h1 class="ez-page-title">Quản lý Role</h1>
        <p class="ez-page-subtitle">Quản lý các nhóm quyền truy cập trên toàn hệ thống EZ Rent.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">+ Tạo Role</a>
    </div>
</div>

<div id="alertContainer">
    <partial name="_StatusMessage" />
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted small mb-0">
        Tổng <strong id="total-roles">@Model.Count()</strong> role
    </p>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Role Name</th>
                    <th style="width:140px">Số user</th>
                    <th>Loại</th>
                    <th style="width:200px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    var isProtected = protectedRoles.Contains(role.Name ?? "", StringComparer.OrdinalIgnoreCase);
                    var userCount = role.Name != null && roleUserCounts.ContainsKey(role.Name)
                                    ? roleUserCounts[role.Name]
                                    : 0;

                    <tr id="role-row-@role.Id" data-id="@role.Id">
                        <td>
                            <span class="fw-bold">@role.Name</span>
                        </td>

                        <td>
                            <span class="badge bg-primary">@userCount</span> user
                        </td>

                        <td>
                            @if (isProtected)
                            {
                                <span class="badge bg-info text-dark">Hệ thống</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tùy chỉnh</span>
                            }
                        </td>

                        <td class="action-cell">
                            @if (isProtected)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                        title="Không thể xóa role hệ thống">
                                    Không thể xóa
                                </button>
                            }
                            else if (userCount > 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning" disabled
                                        title="Còn @userCount user đang giữ role này">
                                    Còn @userCount user
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete-role"
                                        data-id="@role.Id"
                                        data-name="@role.Name">
                                    Xóa
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form id="afForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const afInput = document.querySelector('#afForm input[name="__RequestVerificationToken"]');
            const AF_TOKEN = afInput ? afInput.value : '';

            const alertContainer = document.getElementById('alertContainer');

            function showAlert(message, type = 'warning') {
                const html = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                alertContainer.insertAdjacentHTML('afterbegin', html);

                setTimeout(() => {
                    const first = alertContainer.querySelector('.alert');
                    if (first) bootstrap.Alert.getOrCreateInstance(first).close();
                }, 4000);
            }

            async function postAction(url) {
                const body = new URLSearchParams({
                    __RequestVerificationToken: AF_TOKEN
                });

                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return await res.json();
            }

            function updateTotalRoles(delta) {
                const el = document.getElementById('total-roles');
                if (!el) return;

                const cur = parseInt(el.textContent) || 0;
                el.textContent = Math.max(0, cur + delta);
            }

            async function doDelete(id, name, btn) {
                if (!confirm(`Xóa role "${name}"?\n\nHành động này không thể hoàn tác!`)) return;

                btn.disabled = true;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = 'Đang xóa...';

                try {
                    const data = await postAction(`/Admin/RoleManager/Delete/${id}`);

                    if (data.success) {
                        const row = document.getElementById(`role-row-${id}`);
                        if (row) {
                            row.style.transition = 'opacity 0.4s';
                            row.style.opacity = '0';
                            setTimeout(() => row.remove(), 400);
                        }

                        updateTotalRoles(-1);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }

            document.querySelectorAll('.btn-delete-role').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    doDelete(btn.dataset.id, btn.dataset.name, btn);
                });
            });
        });
    </script>
}
