@{
    ViewData["Title"] = "Tạo Role mới";
}

<partial name="_AdminMenu" />

<div class="ez-page-header mb-4">
    <div>
        <span class="ez-eyebrow">Phân quyền hệ thống</span>
        <h1 class="ez-page-title">Tạo Role mới</h1>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Tên Role</label>
                        <input name="roleName" class="form-control" placeholder="Ví dụ: Moderator" required />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Tạo Role</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
