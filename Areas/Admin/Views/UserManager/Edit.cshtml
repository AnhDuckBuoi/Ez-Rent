@model EZ_Rent.Models.ApplicationUser

@{
    ViewData["Title"] = "Sửa người dùng";

    var initial = !string.IsNullOrEmpty(Model.FullName)
        ? Model.FullName.Trim().First().ToString().ToUpper()
        : "?";
}

<partial name="_AdminMenu" />

<div class="ez-page-header mb-4">
    <div>
        <span class="ez-eyebrow">Quản lý tài khoản</span>
        <h1 class="ez-page-title">Sửa thông tin người dùng</h1>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <strong>Chỉnh sửa thông tin</strong>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName" class="form-label">
                                Họ và tên <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="UserName" class="form-label">Username</label>
                            <input asp-for="UserName" class="form-control bg-light" readonly />
                            <small class="text-muted">Username không thể thay đổi.</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">
                                Email <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label class="form-label">Vai trò</label>
                        <div class="border rounded p-3 bg-light">
                            <partial name="_RoleCheckboxes" />
                        </div>
                        <small class="text-muted">
                            Bỏ chọn để xóa vai trò cũ, chọn để thêm vai trò mới.
                        </small>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        <a asp-action="Details" asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">Xem chi tiết</a>
                        <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <div class="rounded-circle mb-3 d-inline-flex align-items-center justify-content-center"
                     style="width:88px; height:88px; background: var(--ez-soft); color: var(--ez-blue); font-size:32px; font-weight:700;">
                    @initial
                </div>
                <h6 class="mb-1">@Model.FullName</h6>
                <p class="text-muted small mb-2">@Model.Email</p>
                <p class="text-muted small mb-0">
                    Tham gia: @Model.CreatedAt.ToString("dd/MM/yyyy")
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
