@model EZ_Rent.Models.ApplicationUser

@{
    ViewData["Title"] = "Thêm người dùng";
}

<h1>➕ Thêm người dùng mới</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <strong>Thông tin người dùng</strong>
            </div>
            <div class="card-body">

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName" class="form-label">
                                <strong>Họ và tên</strong> <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label">
                                <strong>Email</strong> <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="user@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Password" class="form-label">
                                <strong>Mật khẩu</strong> <span class="text-danger">*</span>
                            </label>
                            <input type="password" name="password" id="Password" class="form-control"
                                   placeholder="Ít nhất 6 ký tự" required />
                            <small class="text-muted">
                                Yêu cầu: ít nhất 6 ký tự, có chữ hoa, chữ thường và số.
                            </small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label">
                                <strong>Số điện thoại</strong>
                            </label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0912345678" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label class="form-label">
                            <strong>Vai trò</strong>
                        </label>
                        <div class="border rounded p-3 bg-light">
                            <partial name="_RoleCheckboxes" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            💾 Tạo người dùng
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            ← Quay lại danh sách
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-info">
            <div class="card-header bg-info text-white">
                <strong>💡 Gợi ý</strong>
            </div>
            <div class="card-body small">
                <ul class="mb-0 ps-3">
                    <li>Email phải là duy nhất trong hệ thống.</li>
                    <li>Mật khẩu cần đủ mạnh để bảo mật.</li>
                    <li>Có thể gán nhiều vai trò cho 1 user.</li>
                    <li>User mới sẽ nhận email xác nhận (nếu cấu hình SMTP).</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}