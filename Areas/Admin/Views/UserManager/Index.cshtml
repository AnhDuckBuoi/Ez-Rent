@using EZ_Rent.Helpers
@model PaginatedList<EZ_Rent.Models.ApplicationUser>
@using EZ_Rent.Models
@using EZ_Rent.Models.Enums

@{
    ViewData["Title"] = "Quản lý người dùng";

    var userRoles = ViewBag.UserRoles as Dictionary<string, List<string>>
                    ?? new Dictionary<string, List<string>>();
}

<h1>Quản lý người dùng</h1>

<div id="alertContainer">
    <partial name="_StatusMessage" />
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">
        Tổng <strong>@Model.TotalItems</strong> người dùng —
        Trang <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong>
    </p>
    <a asp-action="Create" class="btn btn-primary">+ Thêm người dùng</a>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Họ tên</th>
            <th>Username</th>
            <th>Vai trò</th>
            <th>Trạng thái</th>
            <th style="width:320px">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            var roles = userRoles.ContainsKey(item.Id)
                ? userRoles[item.Id]
                : new List<string>();

            var isLocked = item.Status == UserStatus.Locked ||
                           (item.LockoutEnd.HasValue && item.LockoutEnd.Value > DateTimeOffset.Now);

            var initial = !string.IsNullOrEmpty(item.FullName)
                ? item.FullName.Trim().First().ToString().ToUpper()
                : "?";

            <tr id="user-row-@item.Id" data-user-id="@item.Id">
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:36px; height:36px;
                                    background: linear-gradient(135deg, #667eea, #764ba2);
                                    color:white; font-size:15px; font-weight:bold;">
                            @initial
                        </div>
                        <div>
                            <div class="fw-bold">@item.FullName</div>
                            <small class="text-muted">@item.Email</small>
                        </div>
                    </div>
                </td>

                <td>@item.UserName</td>

                <td>
                    @if (roles.Any())
                    {
                        @foreach (var role in roles)
                        {
                            <span class="badge bg-info text-dark me-1">@role</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>

                <td class="status-cell">
                    @if (isLocked)
                    {
                        <span class="badge bg-danger">🔒 Đã khóa</span>
                    }
                    else
                    {
                        <span class="badge bg-success">✅ Hoạt động</span>
                    }
                </td>

                <td class="action-cell">
                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-secondary">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">Xóa</a>

                    @if (isLocked)
                    {
                        <button type="button" class="btn btn-sm btn-success btn-toggle-lock"
                                data-id="@item.Id"
                                data-action="Unlock"
                                data-fullname="@item.FullName">
                            🔓 Mở khóa
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-warning btn-toggle-lock"
                                data-id="@item.Id"
                                data-action="Lock"
                                data-fullname="@item.FullName">
                            🔒 Khóa
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pagination", PaginationInfo.From(
    Model,
    action: "Index",
    controller: "UserManager",
    area: "Admin"))

<form id="afForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const afInput = document.querySelector('#afForm input[name="__RequestVerificationToken"]');
            const AF_TOKEN = afInput ? afInput.value : '';

            const alertContainer = document.getElementById('alertContainer');

            function showAlert(message, type = 'warning') {
                const html = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                alertContainer.insertAdjacentHTML('afterbegin', html);

                setTimeout(() => {
                    const first = alertContainer.querySelector('.alert');
                    if (first) bootstrap.Alert.getOrCreateInstance(first).close();
                }, 4000);
            }

            async function postAction(url) {
                const body = new URLSearchParams({
                    __RequestVerificationToken: AF_TOKEN
                });

                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return await res.json();
            }

            async function doToggle(id, action, fullName, btn) {
                const confirmMsg = action === 'Lock'
                    ? `Khóa tài khoản "${fullName}"?`
                    : `Mở khóa tài khoản "${fullName}"?`;

                if (!confirm(confirmMsg)) return;

                btn.disabled = true;
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '⏳...';

                try {
                    const data = await postAction(`/Admin/UserManager/${action}/${id}`);

                    if (data.success) {
                        updateUserRow(id, data.newStatus, fullName);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }

            function updateUserRow(id, newStatus, fullName) {
                const row = document.getElementById(`user-row-${id}`);
                if (!row) return;

                const isLocked = newStatus === 'Locked';

                const statusCell = row.querySelector('.status-cell');
                statusCell.innerHTML = isLocked
                    ? '<span class="badge bg-danger">🔒 Đã khóa</span>'
                    : '<span class="badge bg-success">✅ Hoạt động</span>';

                const actionCell = row.querySelector('.action-cell');
                const oldToggle = actionCell.querySelector('.btn-toggle-lock');
                if (oldToggle) oldToggle.remove();

                const newBtn = document.createElement('button');
                newBtn.type = 'button';
                newBtn.className = isLocked
                    ? 'btn btn-sm btn-success btn-toggle-lock'
                    : 'btn btn-sm btn-warning btn-toggle-lock';
                newBtn.dataset.id       = id;
                newBtn.dataset.action   = isLocked ? 'Unlock' : 'Lock';
                newBtn.dataset.fullname = fullName;
                newBtn.innerHTML        = isLocked ? '🔓 Mở khóa' : '🔒 Khóa';

                newBtn.addEventListener('click', function () {
                    doToggle(id, newBtn.dataset.action, fullName, newBtn);
                });

                actionCell.appendChild(newBtn);
            }

            document.querySelectorAll('.btn-toggle-lock').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    doToggle(btn.dataset.id, btn.dataset.action, btn.dataset.fullname, btn);
                });
            });
        });
    </script>
}