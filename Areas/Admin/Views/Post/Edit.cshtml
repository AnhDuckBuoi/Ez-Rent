@{
    ViewData["Title"] = "Tạo Role mới";
}

<h1>➕ Tạo Role mới</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <strong>Thông tin Role</strong>
            </div>
            <div class="card-body">

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label for="roleName" class="form-label">
                            <strong>Tên Role</strong> <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               id="roleName"
                               name="roleName"
                               class="form-control form-control-lg"
                               placeholder="VD: Moderator, Accountant, Shipper..."
                               maxlength="50"
                               autocomplete="off"
                               required />
                        <small class="text-muted">
                            Tên role nên viết bằng tiếng Anh, không dấu, không khoảng trắng.
                            Tối đa 50 ký tự.
                        </small>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            💾 Tạo Role
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            ← Quay lại danh sách
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-info">
            <div class="card-header bg-info text-white">
                <strong>💡 Gợi ý</strong>
            </div>
            <div class="card-body small">
                <p class="mb-2"><strong>Các role hệ thống hiện có:</strong></p>
                <ul class="mb-3 ps-3">
                    <li><code>Admin</code> — Quản trị viên (không thể xóa)</li>
                    <li><code>Landlord</code> — Chủ trọ (không thể xóa)</li>
                    <li><code>Tenant</code> — Người thuê (không thể xóa)</li>
                </ul>

                <p class="mb-2"><strong>Lưu ý khi tạo role mới:</strong></p>
                <ul class="mb-0 ps-3">
                    <li>Role mới chưa có user nào giữ.</li>
                    <li>Cần gán role cho user qua trang <strong>Quản lý người dùng</strong>.</li>
                    <li>Tên role không được trùng với role đã có.</li>
                    <li>Role tùy chỉnh có thể xóa được (nếu rỗng).</li>
                </ul>
            </div>
        </div>
    </div>
</div>