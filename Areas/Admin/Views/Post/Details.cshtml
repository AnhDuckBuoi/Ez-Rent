@model EZ_Rent.Models.RentalPost
@using EZ_Rent.Models.Enums

@{
    ViewData["Title"] = "Chi tiết tin đăng";

    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var backUrl = string.IsNullOrEmpty(returnUrl)
        ? Url.Action("Index", "Post", new { area = "Admin" })
        : returnUrl;
}

<h1>Chi tiết tin đăng</h1>

<div id="alertContainer">
    <partial name="_StatusMessage" />
</div>

@* ============================================================ *@
@*  KHU VỰC HÀNH ĐỘNG                                            *@
@* ============================================================ *@
<div class="mb-3" id="actionBar">
    <a href="@backUrl" class="btn btn-outline-secondary">← Quay lại danh sách</a>

    @if (Model.ApprovalStatus == ApprovalStatus.Pending)
    {
        <button type="button" class="btn btn-success btn-approve" data-id="@Model.RentalPostId">
            ✅ Duyệt
        </button>

        <button type="button" class="btn btn-danger btn-reject" data-id="@Model.RentalPostId" data-title="@Model.Title">
            ❌ Từ chối
        </button>

        <button type="button" class="btn btn-warning btn-revision" data-id="@Model.RentalPostId" data-title="@Model.Title">
            🔄 Yêu cầu sửa
        </button>
    }
    else if (Model.ApprovalStatus == ApprovalStatus.Approved)
    {
        <button type="button" class="btn btn-outline-danger btn-revoke" data-id="@Model.RentalPostId">
            Hủy duyệt
        </button>

        @* ⭐ Nút GỠ BÀI *@
        <button type="button" class="btn btn-dark btn-remove"
                data-id="@Model.RentalPostId"
                data-title="@Model.Title">
            🗑️ Gỡ bài
        </button>
    }
    else if (Model.ApprovalStatus == ApprovalStatus.Rejected)
    {
        <button type="button" class="btn btn-success btn-approve" data-id="@Model.RentalPostId">
            Duyệt lại
        </button>

        <button type="button" class="btn btn-dark btn-remove"
                data-id="@Model.RentalPostId"
                data-title="@Model.Title">
            🗑️ Gỡ bài
        </button>
    }
    else if (Model.ApprovalStatus == ApprovalStatus.NeedRevision)
    {
        <button type="button" class="btn btn-success btn-approve" data-id="@Model.RentalPostId">
            Duyệt
        </button>

        <button type="button" class="btn btn-danger btn-reject" data-id="@Model.RentalPostId" data-title="@Model.Title">
            Từ chối
        </button>

        <button type="button" class="btn btn-dark btn-remove"
                data-id="@Model.RentalPostId"
                data-title="@Model.Title">
            🗑️ Gỡ bài
        </button>
    }
    else if (Model.ApprovalStatus == ApprovalStatus.Removed)
    {
        <div class="alert alert-dark mb-0 d-inline-block">
            🗑️ Bài viết đã bị gỡ khỏi hệ thống
        </div>

        @* Cho phép khôi phục *@
        <button type="button" class="btn btn-success btn-approve" data-id="@Model.RentalPostId">
            ♻️ Khôi phục (duyệt lại)
        </button>
    }
</div>

@* ============================================================ *@
@*  THÔNG TIN CHI TIẾT                                            *@
@* ============================================================ *@
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-start">
        <h4 class="mb-0">@Model.Title</h4>
        <div class="status-cell">
            @switch (Model.ApprovalStatus)
            {
                case ApprovalStatus.Pending:
                    <span class="badge bg-warning text-dark fs-6">⏳ Chờ duyệt</span>
                    break;
                case ApprovalStatus.Approved:
                    <span class="badge bg-success fs-6">✅ Đã duyệt</span>
                    break;
                case ApprovalStatus.Rejected:
                    <span class="badge bg-danger fs-6">❌ Từ chối</span>
                    break;
                case ApprovalStatus.NeedRevision:
                    <span class="badge bg-info text-dark fs-6">🔄 Cần sửa</span>
                    break;
                case ApprovalStatus.Removed:
                    <span class="badge bg-dark fs-6">🗑️ Đã gỡ</span>
                    break;
                case ApprovalStatus.Draft:
                    <span class="badge bg-secondary fs-6">📝 Nháp</span>
                    break;
            }
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-7">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mô tả</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4">Giá thuê</dt>
                    <dd class="col-sm-8">
                        <strong class="text-danger">@Model.Price.ToString("N0")đ / tháng</strong>
                    </dd>

                    <dt class="col-sm-4">Diện tích</dt>
                    <dd class="col-sm-8">@Model.Area m²</dd>

                    <dt class="col-sm-4">Địa chỉ</dt>
                    <dd class="col-sm-8">
                        @Model.Address, @Model.Ward, @Model.District, @Model.City
                        @if (!string.IsNullOrEmpty(Model.MapLocation))
                        {
                            <br />
                            <a href="@Model.MapLocation" target="_blank">📍 Xem trên Google Maps</a>
                        }
                    </dd>

                    <dt class="col-sm-4">Loại phòng</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(m => m.RoomType)</dd>

                    <dt class="col-sm-4">Trạng thái phòng</dt>
                    <dd class="col-sm-8 room-status-cell">
                        @switch (Model.RoomStatus)
                        {
                            case RoomStatus.Available:
                                <span class="badge bg-success">🟢 Còn trống</span>
                                break;
                            case RoomStatus.Rented:
                                <span class="badge bg-danger">🔴 Đã thuê</span>
                                break;
                            case RoomStatus.Hidden:
                                <span class="badge bg-secondary">⚫ Ẩn</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Tiện ích</dt>
                    <dd class="col-sm-8">@Model.AmenitiesJson</dd>

                    <dt class="col-sm-4">Đơn giá điện</dt>
                    <dd class="col-sm-8">@Model.ElectricityUnitPrice.ToString("N0")đ / kWh</dd>

                    <dt class="col-sm-4">Đơn giá nước</dt>
                    <dd class="col-sm-8">@Model.WaterUnitPrice.ToString("N0")đ / m³</dd>

                    <dt class="col-sm-4">Phí dịch vụ</dt>
                    <dd class="col-sm-8">@Model.ServiceFee.ToString("N0")đ / tháng</dd>

                    <dt class="col-sm-4">Có sẵn từ</dt>
                    <dd class="col-sm-8">@Model.AvailableFrom.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>

            <div class="col-md-5">
                @{
                    var ownerInitial = !string.IsNullOrEmpty(Model.Owner?.FullName)
                        ? Model.Owner.FullName.Trim().First().ToString().ToUpper()
                        : "?";
                }

                <div class="card mb-3">
                    <div class="card-header"><strong>Chủ trọ</strong></div>
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:46px; height:46px;
                                        background: linear-gradient(135deg, #667eea, #764ba2);
                                        color:white; font-size:20px; font-weight:bold;">
                                @ownerInitial
                            </div>
                            <div>
                                <p class="mb-0 fw-bold">@Model.Owner?.FullName</p>
                                <p class="text-muted small mb-0">@Model.Owner?.Email</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header"><strong>Lịch sử duyệt</strong></div>
                    <div class="card-body">
                        <p class="mb-1">
                            <small class="text-muted">Ngày tạo:</small>
                            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        @if (Model.PostedAt.HasValue)
                        {
                            <p class="mb-1">
                                <small class="text-muted">Ngày duyệt đăng:</small>
                                @Model.PostedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        }

                        @if (Model.ApprovedBy != null)
                        {
                            <p class="mb-1">
                                <small class="text-muted">Người duyệt:</small>
                                @Model.ApprovedBy.FullName
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(Model.ApprovalNote))
                        {
                            <hr />
                            <p class="mb-0 note-cell">
                                <small class="text-muted">Ghi chú:</small>
                                <br />
                                @Model.ApprovalNote
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ============================================================ *@
@*  HÌNH ẢNH                                                     *@
@* ============================================================ *@
@if (Model.RoomImages != null && Model.RoomImages.Any())
{
    <div class="card mb-3">
        <div class="card-header"><strong>Hình ảnh (@Model.RoomImages.Count)</strong></div>
        <div class="card-body">
            <div class="row g-2">
                @foreach (var img in Model.RoomImages.OrderBy(i => i.DisplayOrder))
                {
                    <div class="col-3">
                        <img src="@img.MediaUrl" class="img-fluid rounded"
                             style="height:120px; width:100%; object-fit:cover;" />
                        @if (img.IsPrimary)
                        {
                            <span class="badge bg-primary">Ảnh chính</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ============================================================ *@
@*  DỊCH VỤ                                                      *@
@* ============================================================ *@
@if (Model.Services != null && Model.Services.Any())
{
    <div class="card mb-3">
        <div class="card-header"><strong>Dịch vụ</strong></div>
        <ul class="list-group list-group-flush">
            @foreach (var s in Model.Services)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@s.Name</span>
                    <span class="fw-bold">@s.UnitPrice.ToString("N0")đ / @s.Unit</span>
                </li>
            }
        </ul>
    </div>
}

@* ============================================================ *@
@*  MODAL TỪ CHỐI                                                *@
@* ============================================================ *@
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Từ chối tin đăng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="rejectId" />
                <p><strong>Tin:</strong> <span id="rejectTitle"></span></p>
                <label for="rejectNote" class="form-label">
                    Lý do từ chối <span class="text-danger">*</span>
                </label>
                <textarea id="rejectNote" class="form-control" rows="3" required maxlength="1000"
                          placeholder="VD: Hình ảnh không rõ, giá không hợp lý..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="btnConfirmReject">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@* ============================================================ *@
@*  MODAL YÊU CẦU SỬA                                            *@
@* ============================================================ *@
<div class="modal fade" id="revisionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yêu cầu chủ trọ sửa lại</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="revisionId" />
                <p><strong>Tin:</strong> <span id="revisionTitle"></span></p>
                <label for="revisionNote" class="form-label">
                    Nội dung cần sửa <span class="text-danger">*</span>
                </label>
                <textarea id="revisionNote" class="form-control" rows="3" required maxlength="1000"
                          placeholder="VD: Bổ sung ảnh rõ hơn..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning" id="btnConfirmRevision">Gửi yêu cầu</button>
            </div>
        </div>
    </div>
</div>

@* ============================================================ *@
@*  ⭐ MODAL GỠ BÀI                                              *@
@* ============================================================ *@
<div class="modal fade" id="removeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">🗑️ Gỡ bài viết</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="removeId" />
                <p><strong>Tin:</strong> <span id="removeTitle"></span></p>

                <div class="alert alert-warning">
                    <strong>⚠️ Lưu ý:</strong>
                    Bài viết sẽ bị <strong>gỡ khỏi hệ thống</strong> và không hiển thị với người thuê.
                    Chủ trọ vẫn có thể thấy tin này nhưng không thể chỉnh sửa để đăng lại.
                    Admin có thể <strong>khôi phục</strong> nếu cần.
                </div>

                <label for="removeNote" class="form-label">
                    Lý do gỡ <span class="text-danger">*</span>
                </label>
                <textarea id="removeNote" class="form-control" rows="3" required maxlength="1000"
                          placeholder="VD: Nội dung sai sự thật, hình ảnh không phù hợp, trùng lặp..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-dark" id="btnConfirmRemove">
                    🗑️ Xác nhận gỡ
                </button>
            </div>
        </div>
    </div>
</div>

@* Form ẩn — chứa AntiForgeryToken cho AJAX *@
<form id="afForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const afInput = document.querySelector('#afForm input[name="__RequestVerificationToken"]');
            const AF_TOKEN = afInput ? afInput.value : '';

            const alertContainer = document.getElementById('alertContainer');

            // ================= Alert =================
            function showAlert(message, type = 'warning') {
                const html = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                alertContainer.insertAdjacentHTML('afterbegin', html);

                setTimeout(() => {
                    const first = alertContainer.querySelector('.alert');
                    if (first) bootstrap.Alert.getOrCreateInstance(first).close();
                }, 4000);
            }

            // ================= POST helper =================
            async function postAction(url, params = {}) {
                const body = new URLSearchParams({
                    __RequestVerificationToken: AF_TOKEN,
                    ...params
                });

                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body.toString()
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                return await res.json();
            }

            // ================= RENDER BADGES =================
            function renderApprovalBadge(status) {
                switch (status) {
                    case 'Pending':
                        return '<span class="badge bg-warning text-dark fs-6">⏳ Chờ duyệt</span>';
                    case 'Approved':
                        return '<span class="badge bg-success fs-6">✅ Đã duyệt</span>';
                    case 'Rejected':
                        return '<span class="badge bg-danger fs-6">❌ Từ chối</span>';
                    case 'NeedRevision':
                        return '<span class="badge bg-info text-dark fs-6">🔄 Cần sửa</span>';
                    case 'Removed':
                        return '<span class="badge bg-dark fs-6">🗑️ Đã gỡ</span>';
                    default:
                        return '<span class="badge bg-secondary fs-6">📝 Nháp</span>';
                }
            }

            function renderRoomStatusBadge(status) {
                switch (status) {
                    case 'Available':
                        return '<span class="badge bg-success">🟢 Còn trống</span>';
                    case 'Rented':
                        return '<span class="badge bg-danger">🔴 Đã thuê</span>';
                    case 'Hidden':
                        return '<span class="badge bg-secondary">⚫ Ẩn</span>';
                    default:
                        return status;
                }
            }

            // ================= RENDER ACTIONS =================
            function renderActions(id, status, title) {
                const backBtn = `<a href="@backUrl" class="btn btn-outline-secondary">← Quay lại danh sách</a>`;
                const removeBtn = `<button type="button" class="btn btn-dark btn-remove" data-id="${id}" data-title="${title}">🗑️ Gỡ bài</button>`;

                if (status === 'Pending') {
                    return backBtn + `
                        <button type="button" class="btn btn-success btn-approve" data-id="${id}">✅ Duyệt</button>
                        <button type="button" class="btn btn-danger btn-reject" data-id="${id}" data-title="${title}">❌ Từ chối</button>
                        <button type="button" class="btn btn-warning btn-revision" data-id="${id}" data-title="${title}">🔄 Yêu cầu sửa</button>`;
                }
                if (status === 'Approved') {
                    return backBtn + `
                        <button type="button" class="btn btn-outline-danger btn-revoke" data-id="${id}">Hủy duyệt</button>
                        ${removeBtn}`;
                }
                if (status === 'Rejected') {
                    return backBtn + `
                        <button type="button" class="btn btn-success btn-approve" data-id="${id}">Duyệt lại</button>
                        ${removeBtn}`;
                }
                if (status === 'NeedRevision') {
                    return backBtn + `
                        <button type="button" class="btn btn-success btn-approve" data-id="${id}">Duyệt</button>
                        <button type="button" class="btn btn-danger btn-reject" data-id="${id}" data-title="${title}">Từ chối</button>
                        ${removeBtn}`;
                }
                if (status === 'Removed') {
                    return backBtn + `
                        <div class="alert alert-dark mb-0 d-inline-block">🗑️ Bài viết đã bị gỡ khỏi hệ thống</div>
                        <button type="button" class="btn btn-success btn-approve" data-id="${id}">♻️ Khôi phục (duyệt lại)</button>`;
                }
                return backBtn;
            }

            // ================= UPDATE UI =================
            function updateUI(id, newApprovalStatus, newRoomStatus, note, title) {
                // 1. Cập nhật badge
                const statusCell = document.querySelector('.status-cell');
                if (statusCell) statusCell.innerHTML = renderApprovalBadge(newApprovalStatus);

                // 2. Cập nhật room status
                if (newRoomStatus) {
                    const roomCell = document.querySelector('.room-status-cell');
                    if (roomCell) roomCell.innerHTML = renderRoomStatusBadge(newRoomStatus);
                }

                // 3. Cập nhật action bar
                const actionBar = document.getElementById('actionBar');
                actionBar.innerHTML = renderActions(id, newApprovalStatus, title);

                // 4. Cập nhật ghi chú
                if (note !== undefined) {
                    const existingNote = document.querySelector('.card-body .note-cell');
                    if (note) {
                        if (existingNote) {
                            existingNote.innerHTML = `<small class="text-muted">Ghi chú:</small><br />${note}`;
                        }
                    } else if (existingNote) {
                        existingNote.innerHTML = '';
                    }
                }

                // 5. Rebind
                bindEvents();
            }

            // ================= APPROVE =================
            async function doApprove(id, btn) {
                if (!confirm('Duyệt bài viết này?')) return;

                btn.disabled = true;
                btn.innerHTML = '⏳...';

                try {
                    const data = await postAction(`/Admin/Post/Approve/${id}`);

                    if (data.success) {
                        const title = document.querySelector('h4')?.textContent?.trim() || '';
                        updateUI(id, 'Approved', 'Available', null, title);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                        btn.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                    btn.disabled = false;
                }
            }

            // ================= REVOKE =================
            async function doRevoke(id, btn) {
                if (!confirm('Hủy duyệt bài viết này?')) return;

                btn.disabled = true;

                try {
                    const data = await postAction(`/Admin/Post/Revoke/${id}`);

                    if (data.success) {
                        const title = document.querySelector('h4')?.textContent?.trim() || '';
                        updateUI(id, 'Pending', 'Hidden', null, title);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                        btn.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                    btn.disabled = false;
                }
            }

            // ================= REJECT MODAL =================
            function openRejectModal(id, title) {
                document.getElementById('rejectId').value = id;
                document.getElementById('rejectTitle').textContent = title;
                document.getElementById('rejectNote').value = '';
                new bootstrap.Modal(document.getElementById('rejectModal')).show();
            }

            async function submitReject() {
                const id = document.getElementById('rejectId').value;
                const note = document.getElementById('rejectNote').value.trim();

                if (!note) {
                    showAlert('Vui lòng nhập lý do từ chối', 'warning');
                    return;
                }

                const btn = document.getElementById('btnConfirmReject');
                btn.disabled = true;
                btn.innerHTML = '⏳ Đang xử lý...';

                try {
                    const data = await postAction(`/Admin/Post/Reject/${id}`, { note });

                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('rejectModal')).hide();
                        const title = document.querySelector('h4')?.textContent?.trim() || '';
                        updateUI(id, 'Rejected', 'Hidden', note, title);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = 'Xác nhận';
                }
            }

            // ================= REVISION MODAL =================
            function openRevisionModal(id, title) {
                document.getElementById('revisionId').value = id;
                document.getElementById('revisionTitle').textContent = title;
                document.getElementById('revisionNote').value = '';
                new bootstrap.Modal(document.getElementById('revisionModal')).show();
            }

            async function submitRevision() {
                const id = document.getElementById('revisionId').value;
                const note = document.getElementById('revisionNote').value.trim();

                if (!note) {
                    showAlert('Vui lòng nhập nội dung cần sửa', 'warning');
                    return;
                }

                const btn = document.getElementById('btnConfirmRevision');
                btn.disabled = true;
                btn.innerHTML = '⏳ Đang xử lý...';

                try {
                    const data = await postAction(`/Admin/Post/NeedRevision/${id}`, { note });

                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('revisionModal')).hide();
                        const title = document.querySelector('h4')?.textContent?.trim() || '';
                        updateUI(id, 'NeedRevision', 'Hidden', note, title);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = 'Gửi yêu cầu';
                }
            }

            // ================= ⭐ REMOVE MODAL =================
            function openRemoveModal(id, title) {
                document.getElementById('removeId').value = id;
                document.getElementById('removeTitle').textContent = title;
                document.getElementById('removeNote').value = '';
                new bootstrap.Modal(document.getElementById('removeModal')).show();
            }

            async function submitRemove() {
                const id = document.getElementById('removeId').value;
                const note = document.getElementById('removeNote').value.trim();

                if (!note) {
                    showAlert('Vui lòng nhập lý do gỡ bài', 'warning');
                    return;
                }

                const btn = document.getElementById('btnConfirmRemove');
                btn.disabled = true;
                btn.innerHTML = '⏳ Đang xử lý...';

                try {
                    const data = await postAction(`/Admin/Post/Remove/${id}`, { note });

                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('removeModal')).hide();
                        const title = document.querySelector('h4')?.textContent?.trim() || '';
                        updateUI(id, 'Removed', 'Hidden', `[GỠ] ${note}`, title);
                        showAlert(data.message, 'success');
                    } else {
                        showAlert(data.message, 'danger');
                    }
                } catch (err) {
                    console.error(err);
                    showAlert('Lỗi kết nối: ' + err.message, 'danger');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = '🗑️ Xác nhận gỡ';
                }
            }

            // ================= BIND EVENTS =================
            function bindEvents() {
                document.querySelectorAll('.btn-approve').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        doApprove(btn.dataset.id, btn);
                    });
                });

                document.querySelectorAll('.btn-revoke').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        doRevoke(btn.dataset.id, btn);
                    });
                });

                document.querySelectorAll('.btn-reject').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        openRejectModal(btn.dataset.id, btn.dataset.title || '');
                    });
                });

                document.querySelectorAll('.btn-revision').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        openRevisionModal(btn.dataset.id, btn.dataset.title || '');
                    });
                });

                document.querySelectorAll('.btn-remove').forEach(function (btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function () {
                        openRemoveModal(btn.dataset.id, btn.dataset.title || '');
                    });
                });
            }

            bindEvents();

            // Modal confirm buttons
            document.getElementById('btnConfirmReject')?.addEventListener('click', submitReject);
            document.getElementById('btnConfirmRevision')?.addEventListener('click', submitRevision);
            document.getElementById('btnConfirmRemove')?.addEventListener('click', submitRemove);
        });
    </script>
}