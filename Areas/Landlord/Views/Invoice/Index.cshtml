@model IEnumerable<EZ_Rent.Models.Invoice>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RentalContract)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MeterReading)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BillingPeriod)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RoomRentAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ElectricUsage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ElectricAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WaterUsage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WaterAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ServiceFeeAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdjustmentAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IssueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VietQRContent)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenantConfirmedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaidAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Note)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.RentalContract.RentalContractId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MeterReading.Period)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BillingPeriod)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RoomRentAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ElectricUsage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ElectricAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WaterUsage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WaterAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ServiceFeeAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AdjustmentAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IssueDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DueDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VietQRContent)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TenantConfirmedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaidAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Note)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.InvoiceId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.InvoiceId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.InvoiceId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
