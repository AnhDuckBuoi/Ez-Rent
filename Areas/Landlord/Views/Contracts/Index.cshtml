@model ContractListModel
@{
    ViewData["Title"] = "Hợp đồng";
}
<partial name="_LandlordMenu" />
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0">Quản lý hợp đồng</h2>
        <small class="text-muted">Lập hợp đồng (BM03) sau khi hai bên thống nhất. Xác nhận trên hệ thống không phải chữ ký số.</small>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Lập hợp đồng</a>
</div>
<div id="contract-list" data-ll-region>
    <partial name="_ContractList" model="Model" />
</div>
