@model SupportListModel
@{
    ViewData["Title"] = "Hỗ trợ";
}
<partial name="_LandlordMenu" />
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div><h2 class="mb-0">❓ Hỗ trợ từ quản trị viên</h2>
        <small class="text-muted">Gửi câu hỏi về cách dùng, phản ánh về người thuê hoặc báo cáo vi phạm. Lịch sử trao đổi được lưu lại.</small></div>
    <a class="btn btn-primary" asp-action="Create">+ Gửi yêu cầu</a>
</div>
<div id="support-list" data-ll-region>
    <partial name="_SupportList" model="Model" />
</div>
