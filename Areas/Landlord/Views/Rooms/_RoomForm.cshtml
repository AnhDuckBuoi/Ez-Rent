@model RoomFormModel
@{
    var input = Model.Input;
    var creating = Model.Id == null;
}
<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><strong>1. Thông tin chính</strong></div>
        <div class="card-body row g-3">
            <div class="col-12">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" placeholder="Ví dụ: Phòng 25 m² có gác, gần ĐH Mở Hà Nội" />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.RoomType" class="form-label"></label>
                <select asp-for="Input.RoomType" class="form-select">
                    @foreach (var t in Enum.GetValues<RoomType>()) { <option value="@t" selected="@(input.RoomType == t)">@LandlordLabels.RoomTypeName(t)</option> }
                </select>
                <span asp-validation-for="Input.RoomType" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.AvailableFrom" class="form-label"></label>
                <input asp-for="Input.AvailableFrom" type="date" class="form-control" value="@(input.AvailableFrom?.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="Input.AvailableFrom" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Price" class="form-label"></label>
                <input asp-for="Input.Price" type="number" min="100000" step="50000" inputmode="numeric" class="form-control" value="@(input.Price?.ToString("0"))" />
                <span asp-validation-for="Input.Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Area" class="form-label"></label>
                <input asp-for="Input.Area" inputmode="decimal" class="form-control" placeholder="25.5" />
                <span asp-validation-for="Input.Area" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" rows="5" class="form-control" placeholder="Nội thất, giờ giấc, chỗ để xe, an ninh, khoảng cách tới trường/chợ…"></textarea>
                <div class="form-text">Mô tả đúng thực tế giúp tin được duyệt nhanh và tránh tranh cãi khi người thuê đến xem.</div>
                <span asp-validation-for="Input.Description" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><strong>2. Địa chỉ</strong></div>
        <div class="card-body row g-3">
            <div class="col-12">
                <label asp-for="Input.Address" class="form-label"></label>
                <input asp-for="Input.Address" class="form-control" placeholder="Số 96 Định Công" autocomplete="street-address" />
                <span asp-validation-for="Input.Address" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Ward" class="form-label"></label>
                <input asp-for="Input.Ward" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.District" class="form-label"></label>
                <input asp-for="Input.District" class="form-control" placeholder="Hoàng Mai" />
                <span asp-validation-for="Input.District" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.City" class="form-label"></label>
                <input asp-for="Input.City" class="form-control" />
                <span asp-validation-for="Input.City" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.MapLocation" class="form-label"></label>
                <input asp-for="Input.MapLocation" class="form-control" placeholder="https://maps.app.goo.gl/… hoặc 20.9821, 105.8414" />
                <div class="form-text">Dán link chia sẻ Google Maps hoặc tọa độ.</div>
                <span asp-validation-for="Input.MapLocation" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><strong>3. Chi phí hằng tháng</strong> <small class="text-muted">— giá điện nước được điền sẵn vào hợp đồng</small></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <label asp-for="Input.ElectricityUnitPrice" class="form-label"></label>
                    <input asp-for="Input.ElectricityUnitPrice" type="number" min="0" step="100" inputmode="numeric" class="form-control" value="@(input.ElectricityUnitPrice?.ToString("0"))" />
                    <span asp-validation-for="Input.ElectricityUnitPrice" class="text-danger small"></span>
                </div>
                <div class="col-md-3 col-6">
                    <label asp-for="Input.WaterUnitPrice" class="form-label"></label>
                    <input asp-for="Input.WaterUnitPrice" type="number" min="0" step="1000" inputmode="numeric" class="form-control" value="@(input.WaterUnitPrice?.ToString("0"))" />
                    <span asp-validation-for="Input.WaterUnitPrice" class="text-danger small"></span>
                </div>
                <div class="col-md-3 col-6">
                    <label asp-for="Input.InternetFee" class="form-label"></label>
                    <input asp-for="Input.InternetFee" type="number" min="0" step="10000" inputmode="numeric" class="form-control" placeholder="Để trống nếu không thu" value="@(input.InternetFee?.ToString("0"))" />
                    <span asp-validation-for="Input.InternetFee" class="text-danger small"></span>
                </div>
                <div class="col-md-3 col-6">
                    <label asp-for="Input.ServiceFee" class="form-label"></label>
                    <input asp-for="Input.ServiceFee" type="number" min="0" step="10000" inputmode="numeric" class="form-control" value="@(input.ServiceFee?.ToString("0"))" />
                    <span asp-validation-for="Input.ServiceFee" class="text-danger small"></span>
                </div>
            </div>
            <h6 class="mt-4 mb-1">Các khoản phí dịch vụ khác</h6>
            <div class="form-text mb-2">Ví dụ: gửi xe (đ/xe), vệ sinh (đ/tháng), máy giặt chung (đ/người).</div>
            <div id="room-services" data-ll-repeat data-ll-max="10">
                @for (var i = 0; i < input.Services.Count; i++)
                {
                    <div class="row g-2 align-items-end mb-2" data-ll-repeat-row>
                        <div class="col-md-5"><label class="form-label small" for="Input_Services_@(i)__Name">Tên dịch vụ</label>
                            <input class="form-control" id="Input_Services_@(i)__Name" name="Input.Services[@i].Name" value="@input.Services[i].Name" maxlength="100" /></div>
                        <div class="col-md-3 col-6"><label class="form-label small" for="Input_Services_@(i)__UnitPrice">Đơn giá (đ)</label>
                            <input class="form-control" id="Input_Services_@(i)__UnitPrice" name="Input.Services[@i].UnitPrice" value="@(input.Services[i].UnitPrice?.ToString("0"))" type="number" min="0" step="1000" inputmode="numeric" /></div>
                        <div class="col-md-3 col-6"><label class="form-label small" for="Input_Services_@(i)__Unit">Tính theo</label>
                            <input class="form-control" id="Input_Services_@(i)__Unit" name="Input.Services[@i].Unit" value="@(input.Services[i].Unit ?? "tháng")" maxlength="30" /></div>
                        <div class="col-md-1"><button type="button" class="btn btn-outline-danger w-100" data-ll-repeat-remove aria-label="Bỏ dịch vụ này">✕</button></div>
                        <span asp-validation-for="Input.Services[i].Name" class="text-danger small"></span>
                        <span asp-validation-for="Input.Services[i].UnitPrice" class="text-danger small"></span>
                    </div>
                }
                <template>
                    <div class="row g-2 align-items-end mb-2" data-ll-repeat-row>
                        <div class="col-md-5"><label class="form-label small" for="Input_Services___i____Name">Tên dịch vụ</label>
                            <input class="form-control" id="Input_Services___i____Name" name="Input.Services[__i__].Name" maxlength="100" /></div>
                        <div class="col-md-3 col-6"><label class="form-label small" for="Input_Services___i____UnitPrice">Đơn giá (đ)</label>
                            <input class="form-control" id="Input_Services___i____UnitPrice" name="Input.Services[__i__].UnitPrice" type="number" min="0" step="1000" inputmode="numeric" /></div>
                        <div class="col-md-3 col-6"><label class="form-label small" for="Input_Services___i____Unit">Tính theo</label>
                            <input class="form-control" id="Input_Services___i____Unit" name="Input.Services[__i__].Unit" value="tháng" maxlength="30" /></div>
                        <div class="col-md-1"><button type="button" class="btn btn-outline-danger w-100" data-ll-repeat-remove aria-label="Bỏ dịch vụ này">✕</button></div>
                    </div>
                </template>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-ll-repeat-add="room-services">+ Thêm dịch vụ</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><strong>4. Tiện ích</strong></div>
        <div class="card-body row g-2">
            @for (var k = 0; k < LandlordLabels.Amenities.Count; k++)
            {
                var a = LandlordLabels.Amenities[k];
                var id = "amenity-" + k;
                <div class="col-6 col-md-3"><div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Input.Amenities" value="@a" id="@id" checked="@input.Amenities.Contains(a)" />
                    <label class="form-check-label" for="@id">@a</label></div></div>
            }
        </div>
    </div>

    @if (creating)
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white"><strong>5. Ảnh & video</strong></div>
            <div class="card-body">
                <label class="form-label" for="Input_Media">Chọn tối đa 12 file</label>
                <input class="form-control" id="Input_Media" type="file" name="Input.Media" multiple accept="image/jpeg,image/png,video/mp4,video/webm" data-ll-preview="#create-previews" />
                <div class="form-text">Ảnh JPG/PNG tối đa 5 MB; video MP4/WebM tối đa 25 MB. Ảnh đầu tiên làm ảnh đại diện. Nếu form báo lỗi, bạn cần chọn lại ảnh.</div>
                <div id="create-previews" class="ll-previews"></div>
                <span asp-validation-for="Input.Media" class="text-danger small"></span>
            </div>
        </div>
    }

    <div class="d-flex flex-wrap gap-2 justify-content-end mb-4">
        @if (creating)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
            <button class="btn btn-outline-primary" type="submit" name="intent" value="draft">💾 Lưu nháp</button>
            <button class="btn btn-primary" type="submit" name="intent" value="submit">📤 Gửi duyệt</button>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Hủy</a>
            @if (Model.CurrentApproval == ApprovalStatus.Draft)
            {
                <button class="btn btn-outline-primary" type="submit" name="intent" value="draft">💾 Lưu nháp</button>
                <button class="btn btn-primary" type="submit" name="intent" value="submit">📤 Lưu và gửi duyệt</button>
            }
            else
            {
                <button class="btn btn-primary" type="submit" name="intent" value="submit">💾 Lưu thay đổi</button>
            }
        }
    </div>
</form>
