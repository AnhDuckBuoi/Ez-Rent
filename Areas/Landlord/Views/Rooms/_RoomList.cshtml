@model RoomListModel
@{
    var input = Model.Input;
    string TabUrl(ApprovalStatus? s) => Url.Action("Index", new { approval = s, room = input.Room, q = input.Q })!;
    var tabs = new List<TabLink> { new("Tất cả", TabUrl(null), Model.Total, input.Approval == null) };
    foreach (var s in new[] { ApprovalStatus.Draft, ApprovalStatus.Pending, ApprovalStatus.Approved, ApprovalStatus.NeedRevision, ApprovalStatus.Rejected })
        tabs.Add(new(LandlordLabels.Approval(s).Text, TabUrl(s), Model.Counts.GetValueOrDefault(s), input.Approval == s));
}
<partial name="_LlTabs" model="@(new TabsModel(tabs, "room-list", "Lọc theo trạng thái duyệt"))" />
<form class="ll-filter" method="get" asp-action="Index" data-ll-filter="room-list" role="search">
    <input type="hidden" name="approval" value="@input.Approval" />
    <div class="ll-field grow">
        <label for="room-q">Tìm theo tiêu đề, địa chỉ</label>
        <input id="room-q" name="q" value="@input.Q" maxlength="100" type="search" placeholder="Ví dụ: Cầu Giấy" />
    </div>
    <div class="ll-field">
        <label for="room-status">Tình trạng</label>
        <select id="room-status" name="room">
            <option value="">Tất cả</option>
            @foreach (var s in new[] { RoomStatus.Available, RoomStatus.Rented, RoomStatus.Hidden })
            {
                <option value="@s" selected="@(input.Room == s)">@LandlordLabels.Room(s).Text</option>
            }
        </select>
    </div>
    <button class="ll-btn" type="submit">Lọc</button>
</form>

@if (Model.Rooms.Total == 0)
{
    <div class="ll-panel ll-empty">
        @if (Model.Total == 0)
        {
            <h2 data-ll-focus>Bạn chưa có tin phòng nào</h2>
            <p>Đăng tin đầu tiên với ảnh thật, giá thuê và các khoản phí rõ ràng để người thuê dễ quyết định.</p>
            <a class="ll-btn ll-btn--primary" asp-action="Create">Đăng tin phòng</a>
        }
        else
        {
            <h2 data-ll-focus>Không có tin phù hợp bộ lọc</h2>
            <p>Thử bỏ bớt điều kiện lọc hoặc từ khóa.</p>
            <a class="ll-btn" asp-action="Index" data-ll-nav="room-list">Xóa bộ lọc</a>
        }
    </div>
}
else
{
    <div class="ll-table-wrap">
        <table class="ll-table">
            <caption class="ll-visually-hidden" data-ll-focus>Danh sách tin phòng</caption>
            <thead><tr><th scope="col">Phòng</th><th scope="col">Giá thuê</th><th scope="col">Kiểm duyệt</th><th scope="col">Tình trạng</th><th scope="col" class="right">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Rooms.Items)
                {
                    var img = LandlordFormat.SafeMediaUrl(r.ImageUrl);
                    <tr>
                        <td class="main">
                            <div class="ll-room-cell">
                                @if (img != null) { <img class="ll-thumb" src="@img" alt="" loading="lazy" /> }
                                else { <span class="ll-thumb" aria-hidden="true"></span> }
                                <div>
                                    <a class="title" asp-action="Details" asp-route-id="@r.Id">@r.Title</a>
                                    <div class="sub">Mã tin @r.Id · @r.Address</div>
                                    <div class="sub">@LandlordLabels.RoomTypeName(r.RoomType) · @LandlordFormat.Area(r.Area)@(r.PendingViewings > 0 ? $" · {r.PendingViewings} lịch xem chờ" : "")@(r.Favorites > 0 ? $" · {r.Favorites} người lưu tin" : "")</div>
                                </div>
                            </div>
                        </td>
                        <td data-label="Giá thuê" class="num">@LandlordFormat.Money(r.Price)</td>
                        <td data-label="Kiểm duyệt">@LandlordHtml.Badge(LandlordLabels.Approval(r.Approval))</td>
                        <td data-label="Tình trạng">
                            @LandlordHtml.Badge(LandlordLabels.Room(r.Room))
                            @if (r.TenantName != null) { <div class="sub">@r.TenantName</div> }
                        </td>
                        <td>
                            <div class="actions">
                                <a class="ll-btn ll-btn--small" asp-action="Edit" asp-route-id="@r.Id">Sửa</a>
                                @if (r.Room != RoomStatus.Rented)
                                {
                                    var show = r.Room == RoomStatus.Hidden;
                                    <form method="post" asp-action="Visibility" asp-route-id="@r.Id" data-ll-action data-ll-refresh="room-list">
                                        <input type="hidden" name="visible" value="@(show ? "true" : "false")" />
                                        <button class="ll-btn ll-btn--small" type="submit">@(show ? "Hiện tin" : "Ẩn tin")</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_LlPager" model="@PagerModel.For(Context.Request, Model.Rooms, "room-list", "Phân trang tin phòng")" />
}
