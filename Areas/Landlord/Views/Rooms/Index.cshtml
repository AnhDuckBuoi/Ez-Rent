@model RoomListModel
@{
    ViewData["Title"] = "Phòng trọ";
}
<partial name="_LandlordMenu" />
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0">🏠 Quản lý phòng trọ</h2>
        <small class="text-muted">Tin mới cần quản trị viên duyệt trước khi hiển thị. Sửa nội dung tin đã duyệt sẽ gửi duyệt lại (P02).</small>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Đăng tin phòng</a>
</div>
<div id="room-list" data-ll-region>
    <partial name="_RoomList" model="Model" />
</div>
