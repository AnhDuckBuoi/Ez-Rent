@model InvoiceListModel
@{
    ViewData["Title"] = "Hóa đơn";
}
<partial name="_LandlordMenu" />
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h2 class="mb-0">🧾 Quản lý hóa đơn</h2>
        <small class="text-muted">Hóa đơn (BM05) lấy tiền phòng, giá điện nước từ hợp đồng và lượng tiêu thụ từ phiếu chỉ số. Mã VietQR chỉ là thông tin chuyển khoản.</small>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Lập hóa đơn</a>
</div>
<div id="invoice-list" data-ll-region>
    <partial name="_InvoiceList" model="Model" />
</div>
