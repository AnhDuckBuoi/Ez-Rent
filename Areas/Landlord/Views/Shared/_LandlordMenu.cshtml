@* Thanh chức năng chủ trọ, đặt ở đầu mỗi trang bên trong _Layout chung của main.
   Menu thả xuống "Chủ trọ" trên header vẫn dùng được: các link cũ tự chuyển sang trang mới.
   CSS riêng nạp tại đây (không dùng section Styles vì _Layout của main chưa có section này). *@
@{
    var counts = ViewData[LandlordMenuCounts.Key] as LandlordMenuCounts ?? new LandlordMenuCounts();
    var controller = ViewContext.RouteData.Values["controller"] as string ?? "";
    string Active(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    string? Current(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "page" : null;
    var status = TempData[EZ_Rent.Areas.Landlord.Controllers.LandlordAreaController.StatusKey] as string;
    var statusType = TempData[EZ_Rent.Areas.Landlord.Controllers.LandlordAreaController.StatusTypeKey] as string ?? "success";
}
<link rel="stylesheet" href="~/css/landlord.css" asp-append-version="true" />
<script src="~/js/landlord.js" asp-append-version="true" defer></script>
<nav class="ll-menu nav nav-pills flex-nowrap overflow-auto gap-1 mb-4 no-print" aria-label="Chức năng chủ trọ">
    <a class="nav-link @Active("Overview")" aria-current="@Current("Overview")" asp-area="Landlord" asp-controller="Overview" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        <span>Tổng quan</span>
    </a>
    <a class="nav-link @Active("Rooms", "RoomMedia")" aria-current="@Current("Rooms", "RoomMedia")" asp-area="Landlord" asp-controller="Rooms" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span>Phòng trọ</span>
    </a>
    <a class="nav-link @Active("Viewings", "ViewingHours")" aria-current="@Current("Viewings", "ViewingHours")" asp-area="Landlord" asp-controller="Viewings" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        <span>Lịch xem phòng</span>
        @if (counts.PendingViewings > 0) { <span class="badge bg-danger ms-1" aria-label="@counts.PendingViewings lịch chờ xác nhận">@counts.PendingViewings</span> }
    </a>
    <a class="nav-link @Active("Chat", "Messages")" aria-current="@Current("Chat", "Messages")" asp-area="" asp-controller="Chat" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span>Trò chuyện</span>
        @if (counts.UnreadMessages > 0) { <span class="badge bg-danger ms-1" aria-label="@counts.UnreadMessages tin chưa đọc">@(counts.UnreadMessages > 99 ? "99+" : counts.UnreadMessages.ToString())</span> }
    </a>
    <a class="nav-link @Active("Contracts", "ContractDocuments")" aria-current="@Current("Contracts", "ContractDocuments")" asp-area="Landlord" asp-controller="Contracts" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        <span>Hợp đồng</span>
    </a>
    <a class="nav-link @Active("MeterReadings")" aria-current="@Current("MeterReadings")" asp-area="Landlord" asp-controller="MeterReadings" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        <span>Điện, nước</span>
    </a>
    <a class="nav-link @Active("Invoices", "InvoicePayments")" aria-current="@Current("Invoices", "InvoicePayments")" asp-area="Landlord" asp-controller="Invoices" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        <span>Hóa đơn</span>
    </a>
    <a class="nav-link @Active("Repairs")" aria-current="@Current("Repairs")" asp-area="Landlord" asp-controller="Repairs" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        <span>Yêu cầu sửa chữa</span>
        @if (counts.OpenRepairs > 0) { <span class="badge bg-danger ms-1" aria-label="@counts.OpenRepairs yêu cầu mới">@counts.OpenRepairs</span> }
    </a>
    <a class="nav-link @Active("Support")" aria-current="@Current("Support")" asp-area="Landlord" asp-controller="Support" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span>Hỗ trợ</span>
        @if (counts.SupportReplies > 0) { <span class="badge bg-danger ms-1" aria-label="@counts.SupportReplies phản hồi mới">@counts.SupportReplies</span> }
    </a>
    <a class="nav-link @Active("PaymentSettings")" aria-current="@Current("PaymentSettings")" asp-area="Landlord" asp-controller="PaymentSettings" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="3"></rect><rect x="14" y="7" width="3" height="3"></rect><rect x="7" y="14" width="3" height="3"></rect></svg>
        <span>Nhận tiền</span>
    </a>
    <a class="nav-link @Active("Account")" aria-current="@Current("Account")" asp-area="Landlord" asp-controller="Account" asp-action="Index">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <span>Tài khoản</span>
    </a>
</nav>
<div id="ll-alerts" aria-live="polite">
    @if (!string.IsNullOrEmpty(status))
    {
        <div class="alert alert-@statusType alert-dismissible fade show" role="alert">
            @status
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
</div>
