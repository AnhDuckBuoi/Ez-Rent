@model LandlordProblem
@{
    ViewData["Title"] = Model.Title;
}
<partial name="_LandlordMenu" />
<div class="card border-0 shadow-sm text-center py-5" role="alert">
    <div class="card-body">
        <div class="fs-1 mb-2" aria-hidden="true">🔎</div>
        <h2 class="h4" data-ll-focus>@Model.Title</h2>
        <p class="text-muted">@Model.Message</p>
        <a class="btn btn-primary" href="@Model.BackUrl">@Model.BackText</a>
    </div>
</div>
