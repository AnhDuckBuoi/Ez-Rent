@model MeterIndexModel
<form class="ll-filter" method="get" asp-action="Index" data-ll-filter="meter-rooms">
    <div class="ll-field">
        <label for="meter-period">Kỳ ghi nhận</label>
        <input id="meter-period" type="month" name="period" value="@Model.Period" max="@Model.CurrentPeriod" />
    </div>
    <noscript><button class="ll-btn" type="submit">Xem</button></noscript>
    <p class="ll-summary" style="margin:0 0 10px" data-ll-focus>
        @LandlordTime.PeriodLabel(Model.Period): đã ghi <strong>@Model.Recorded</strong>/@Model.Rooms.Total phòng đang cho thuê.
    </p>
</form>
@if (Model.Rooms.Total == 0)
{
    <div class="ll-panel ll-empty">
        <h2>Chưa có phòng nào đang cho thuê</h2>
        <p>Phòng xuất hiện ở đây khi có hợp đồng đang hiệu lực.</p>
        <a class="ll-btn" asp-controller="Contracts" asp-action="Index">Xem hợp đồng</a>
    </div>
}
else
{
    <div class="ll-table-wrap">
        <table class="ll-table">
            <caption class="ll-visually-hidden">Phòng cần ghi chỉ số @LandlordTime.PeriodLabel(Model.Period)</caption>
            <thead><tr><th scope="col">Phòng · Người thuê</th><th scope="col">Điện</th><th scope="col">Nước</th><th scope="col">Kỳ gần nhất</th><th scope="col" class="right">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Rooms.Items)
                {
                    <tr>
                        <td class="main"><strong>@r.RoomTitle</strong><div class="sub">@r.TenantName</div></td>
                        <td data-label="Điện" class="num">@(r.ElectricUsage.HasValue ? LandlordFormat.Number(r.ElectricUsage.Value) + " kWh" : "—")</td>
                        <td data-label="Nước" class="num">@(r.WaterUsage.HasValue ? LandlordFormat.Number(r.WaterUsage.Value) + " m³" : "—")</td>
                        <td data-label="Kỳ gần nhất">@(r.LastPeriod == null ? "Chưa ghi lần nào" : LandlordTime.PeriodLabel(r.LastPeriod))</td>
                        <td>
                            <div class="actions">
                                @if (r.ReadingId.HasValue)
                                {
                                    <a class="ll-btn ll-btn--small" asp-action="Details" asp-route-id="@r.ReadingId">Xem phiếu</a>
                                    @if (!r.HasInvoice)
                                    {
                                        <a class="ll-btn ll-btn--small ll-btn--primary" asp-controller="Invoices" asp-action="Create" asp-route-period="@Model.Period"
                                           asp-route-contractId="@r.ContractId">Lập hóa đơn</a>
                                    }
                                }
                                else
                                {
                                    <a class="ll-btn ll-btn--small ll-btn--primary" asp-action="Create" asp-route-roomId="@r.RoomId" asp-route-period="@Model.Period">Ghi chỉ số</a>
                                }
                                <a class="ll-btn ll-btn--small" asp-action="History" asp-route-id="@r.RoomId">Lịch sử</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_LlPager" model="@PagerModel.For(Context.Request, Model.Rooms, "meter-rooms", "Phân trang phòng")" />
}
