@model MeterHistoryModel
@{
    ViewData["Title"] = "Lịch sử điện nước · " + Model.RoomTitle;
}
<partial name="_LandlordMenu" />
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Điện, nước</a></li><li class="breadcrumb-item active" aria-current="page">Lịch sử</li></ol></nav>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div><h2 class="mb-0">📈 Lịch sử chỉ số</h2><small class="text-muted">@Model.RoomTitle</small></div>
    <a class="btn btn-primary" asp-action="Create" asp-route-roomId="@Model.RoomId">✍️ Ghi chỉ số tháng này</a>
</div>
<div id="meter-history" data-ll-region>
    <partial name="_HistoryList" model="Model" />
</div>
