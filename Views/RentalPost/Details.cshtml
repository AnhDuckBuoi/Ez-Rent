@using System.Text.Json
@using EZ_Rent.Models.Enums
@model EZ_Rent.Models.RentalPost

@{
    ViewData["Title"] = Model.Title;

    var images = Model.RoomImages?.Select(i => i.MediaUrl).Where(u => !string.IsNullOrWhiteSpace(u)).ToList()
                 ?? new List<string>();
    var primaryImg = Model.RoomImages?.FirstOrDefault(i => i.IsPrimary)?.MediaUrl
                     ?? images.FirstOrDefault()
                     ?? "/images/room-placeholder.svg";

    string[] amenities = Array.Empty<string>();
    if (!string.IsNullOrWhiteSpace(Model.AmenitiesJson))
    {
        try { amenities = JsonSerializer.Deserialize<string[]>(Model.AmenitiesJson) ?? Array.Empty<string>(); }
        catch { amenities = Array.Empty<string>(); }
    }

    var ownerInitial = !string.IsNullOrEmpty(Model.Owner?.FullName)
        ? Model.Owner.FullName.Trim().First().ToString().ToUpper()
        : "C";

    string RoomTypeLabel(RoomType type) => type switch
    {
        RoomType.Room => "Phòng trọ",
        RoomType.Apartment => "Căn hộ mini",
        RoomType.House => "Nhà nguyên căn",
        RoomType.Dormitory => "Ký túc xá / Ở ghép",
        _ => type.ToString()
    };
}

<div class="mb-3">
    <a asp-action="Index" class="small fw-semibold">← Quay lại danh sách phòng</a>
</div>

<section class="card overflow-hidden mb-4">
    <img src="@primaryImg" id="public-main-room-image" alt="@Model.Title" style="width:100%; height:380px; object-fit:cover;" />
</section>

<section class="mb-4">
    <span class="badge bg-primary">@RoomTypeLabel(Model.RoomType) · @(Model.RoomStatus == RoomStatus.Available ? "Còn trống" : "Đã thuê")</span>
    <h1 class="mt-2 mb-1">@Model.Title</h1>
    <p class="text-muted small mb-3">@Model.Address, @Model.Ward, @Model.District, @Model.City</p>
    <div class="d-flex align-items-baseline gap-2 flex-wrap">
        <strong class="fs-3 num" style="color: var(--ez-blue);">@Model.Price.ToString("N0") đ</strong>
        <span class="text-muted small">/ tháng</span>
        <span class="badge bg-secondary ms-2 num">@Model.Area.ToString("0.##") m²</span>
    </div>
</section>

<div class="row g-4 align-items-start">
    <div class="col-lg-8">
        <section class="card p-4 mb-3">
            <h2 class="h5 mb-3">Về căn phòng</h2>
            <p class="mb-0 text-secondary" style="white-space: pre-line; line-height: 1.75;">@Model.Description</p>
        </section>

        <section class="card p-4 mb-3">
            <h2 class="h5 mb-3">Tiện ích</h2>
            @if (amenities.Length == 0)
            {
                <p class="text-muted small mb-0">Thông tin tiện ích đang được cập nhật.</p>
            }
            else
            {
                <div class="row g-2">
                    @foreach (var item in amenities)
                    {
                        <div class="col-6 col-md-4 small">@item</div>
                    }
                </div>
            }
        </section>

        <section class="card p-4">
            <h2 class="h5 mb-3">Điện, nước &amp; dịch vụ</h2>
            <div class="d-flex justify-content-between py-2 border-bottom small">
                <span class="text-muted">Giá điện</span>
                <strong class="num">@Model.ElectricityUnitPrice.ToString("N0") đ / kWh</strong>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom small">
                <span class="text-muted">Giá nước</span>
                <strong class="num">@Model.WaterUnitPrice.ToString("N0") đ / m³</strong>
            </div>
            <div class="d-flex justify-content-between py-2 small">
                <span class="text-muted">Phí dịch vụ phòng</span>
                <strong class="num">@Model.ServiceFee.ToString("N0") đ</strong>
            </div>
            <p class="text-muted small mt-3 mb-0">Các khoản hiển thị theo thông tin chủ nhà cung cấp. Hãy xác nhận cách tính phí trước khi thuê.</p>
        </section>
    </div>

    <aside class="col-lg-4">
        <div class="card p-4 text-center">
            <div class="rounded-circle d-inline-grid mx-auto mb-2"
                 style="width: 56px; height: 56px; place-items: center; background: var(--ez-soft); color: var(--ez-blue); font-size: 22px; font-weight: 700;">
                @ownerInitial
            </div>
            <p class="eyebrow mb-1">CHỦ NHÀ</p>
            <h2 class="h5 mb-1">@(Model.Owner?.FullName ?? "Chủ nhà EZ-Rent")</h2>
            <p class="text-muted small mb-3">Người đăng thông tin căn phòng</p>

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Tenant"))
            {
                <a asp-area="Tenant" asp-controller="ViewingBooking" asp-action="Index" asp-route-id="@Model.RentalPostId"
                   class="btn btn-primary w-100 mb-2">
                    Đặt lịch xem phòng
                </a>
                <a asp-area="Tenant" asp-controller="Dashboard" asp-action="Messages" asp-route-RentalPostId="@Model.RentalPostId" asp-route-View="chat"
                   class="btn btn-outline-primary w-100">
                    Nhắn chủ nhà
                </a>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity" asp-page="/Account/Login"
                   asp-route-returnUrl="@Url.Action("Details", "RentalPost", new { area = "Tenant", id = Model.RentalPostId })"
                   class="btn btn-primary w-100 mb-2">
                    Đăng nhập để đặt lịch xem
                </a>
                <p class="text-muted small mb-0">Chọn ngày và giờ đến xem căn phòng này hoặc nhắn trực tiếp cho chủ nhà.</p>
            }
        </div>
    </aside>
</div>
