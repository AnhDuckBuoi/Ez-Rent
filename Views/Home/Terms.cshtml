@{
    ViewData["Title"] = "Điều khoản sử dụng";
}

<section class="ez-discovery-intro">
    <div>
        <p class="eyebrow">QUY CHẾ HOẠT ĐỘNG</p>
        <h1>Điều khoản sử dụng</h1>
        <p>Quy định về quyền và trách nhiệm của Người thuê, Chủ trọ và Quản trị viên trên hệ thống EZ-Rent.</p>
    </div>
</section>

<div class="ez-editorial-layout" style="margin-top: 24px; padding-top: 24px;">
    <div class="card p-4">
        <h2 class="h5 mb-2">1. Nguyên tắc chung</h2>
        <p class="text-muted small mb-4" style="line-height: 1.8;">
            Khi đăng ký tài khoản và sử dụng các dịch vụ trên EZ-Rent, người dùng cam kết cung cấp thông tin chính xác, trung thực và tuân thủ các quy định pháp luật hiện hành về giao dịch dân sự và cho thuê nhà ở.
        </p>

        <h2 class="h5 mb-2">2. Quy định đối với tin đăng cho thuê</h2>
        <p class="text-muted small mb-4" style="line-height: 1.8;">
            Chủ trọ chịu trách nhiệm về tính xác thực của hình ảnh, địa chỉ, diện tích, giá thuê hàng tháng cũng như đơn giá điện, nước và phí dịch vụ đi kèm. Mọi tin đăng mới hoặc chỉnh sửa nội dung đều phải qua bước kiểm duyệt của Quản trị viên trước khi hiển thị công khai.
        </p>

        <h2 class="h5 mb-2">3. Hợp đồng thuê và đối soát hóa đơn</h2>
        <p class="text-muted small mb-4" style="line-height: 1.8;">
            Hợp đồng điện tử (theo mẫu BM03) và các hóa đơn hàng tháng kèm hình ảnh chỉ số công tơ trên EZ-Rent là căn cứ đối soát minh bạch giữa Chủ trọ và Người thuê. Các bên có nghĩa vụ xác nhận số liệu trung thực và thanh toán đúng thời hạn đã thỏa thuận.
        </p>

        <h2 class="h5 mb-2">4. Xử lý vi phạm</h2>
        <p class="text-muted small mb-0" style="line-height: 1.8;">
            Hệ thống có quyền từ chối duyệt, yêu cầu chỉnh sửa hoặc gỡ bỏ các tin đăng sai sự thật, thu phí ngoài niêm yết hoặc vi phạm tiêu chuẩn cộng đồng, đồng thời tạm khóa các tài khoản có hành vi gian lận.
        </p>
    </div>

    <aside class="ez-editorial-aside">
        <h2 class="h6 mb-2">Tài liệu pháp lý</h2>
        <div>
            <a asp-controller="Home" asp-action="Privacy" class="ez-plain-row">
                <span>
                    <strong>Chính sách bảo mật</strong>
                    <small>Bảo vệ dữ liệu cá nhân &amp; hồ sơ</small>
                </span>
                <span class="text-muted">→</span>
            </a>
            <a asp-controller="Home" asp-action="Guide" class="ez-plain-row">
                <span>
                    <strong>Cẩm nang thuê phòng</strong>
                    <small>Hướng dẫn quy trình chuẩn</small>
                </span>
                <span class="text-muted">→</span>
            </a>
            <a asp-controller="Home" asp-action="About" class="ez-plain-row">
                <span>
                    <strong>Về EZ-Rent</strong>
                    <small>Thông tin dự án &amp; đội ngũ</small>
                </span>
                <span class="text-muted">→</span>
            </a>
        </div>
    </aside>
</div>
