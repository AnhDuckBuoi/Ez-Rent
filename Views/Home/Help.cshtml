@{
    ViewData["Title"] = "Trung tâm trợ giúp";
}

<section class="ez-discovery-intro">
    <div>
        <p class="eyebrow">HỖ TRỢ &amp; GIẢI ĐÁP</p>
        <h1>Trung tâm trợ giúp (FAQ)</h1>
        <p>Giải đáp các câu hỏi thường gặp dành cho người thuê phòng và chủ nhà trên EZ-Rent.</p>
    </div>
</section>

<div class="ez-editorial-layout" style="margin-top: 24px; padding-top: 24px;">
    <div class="d-flex flex-column gap-3">
        <article class="card p-4">
            <span class="eyebrow mb-1">CÂU HỎI 01 · ĐẶT LỊCH XEM PHÒNG</span>
            <h2 class="h5 mb-2">Làm thế nào để đặt lịch hẹn xem phòng với chủ nhà?</h2>
            <p class="text-muted small mb-0" style="line-height: 1.75;">
                Tại trang chi tiết căn phòng bạn quan tâm, nhấn nút <strong>Đặt lịch xem phòng</strong>, chọn ngày và khung giờ mà chủ nhà đang mở nhận khách. Yêu cầu của bạn sẽ được gửi ngay tới chủ trọ và hiển thị trạng thái xác nhận trong mục <strong>Lịch hẹn</strong>.
            </p>
        </article>

        <article class="card p-4">
            <span class="eyebrow mb-1">CÂU HỎI 02 · CHI PHÍ &amp; HÓA ĐƠN</span>
            <h2 class="h5 mb-2">Tôi kiểm tra chỉ số điện nước hàng tháng ở đâu?</h2>
            <p class="text-muted small mb-0" style="line-height: 1.75;">
                Người thuê đang có hợp đồng hiệu lực có thể truy cập mục <strong>Phòng đang ở → Hóa đơn</strong>. Mỗi hóa đơn đều đính kèm chỉ số điện/nước kỳ trước, chỉ số kỳ này và ảnh chụp công tơ thực tế do chủ nhà tải lên để bạn đối chiếu trước khi quét mã VietQR thanh toán.
            </p>
        </article>

        <article class="card p-4">
            <span class="eyebrow mb-1">CÂU HỎI 03 · DÀNH CHO CHỦ TRỌ</span>
            <h2 class="h5 mb-2">Tôi muốn đăng tin cho thuê phòng thì cần làm gì?</h2>
            <p class="text-muted small mb-0" style="line-height: 1.75;">
                Sau khi đăng nhập, bạn có thể đăng ký vai trò Chủ trọ và truy cập <strong>Chủ trọ → Phòng trọ → Đăng tin phòng</strong>. Tin đăng mới sẽ được Quản trị viên kiểm duyệt nội dung, hình ảnh và bảng giá dịch vụ trước khi hiển thị công khai nhằm đảm bảo chất lượng tin đăng trên toàn hệ thống.
            </p>
        </article>

        <article class="card p-4">
            <span class="eyebrow mb-1">CÂU HỎI 04 · SỰ CỐ &amp; KHIẾU NẠI</span>
            <h2 class="h5 mb-2">Khi thiết bị trong phòng gặp sự cố nhưng chậm được xử lý thì làm sao?</h2>
            <p class="text-muted small mb-0" style="line-height: 1.75;">
                Bạn hãy tạo yêu cầu tại mục <strong>Sửa chữa</strong> trong không gian Người thuê. Nếu quá thời gian cam kết mà yêu cầu chưa được phản hồi, bạn có thể gửi yêu cầu hỗ trợ tại mục <strong>Hỗ trợ</strong> để Quản trị viên trực tiếp đôn đốc và giải quyết.
            </p>
        </article>
    </div>

    <aside class="ez-editorial-aside">
        <h2 class="h6 mb-2">Liên hệ trực tiếp</h2>
        <div class="card p-3 mb-3">
            <div class="small text-muted mb-1">Tổng đài hỗ trợ (08:00 - 21:00)</div>
            <div class="fw-bold num fs-5" style="color: var(--ez-blue);">1900 6868</div>
            <div class="small text-muted mt-2 mb-1">Email CSKH</div>
            <div class="fw-semibold small">support@ezrent.vn</div>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Guide" class="ez-plain-row">
                <span>
                    <strong>Xem cẩm nang thuê phòng</strong>
                    <small>Quy trình 4 bước chi tiết</small>
                </span>
                <span class="text-muted">→</span>
            </a>
            <a asp-controller="Home" asp-action="Terms" class="ez-plain-row">
                <span>
                    <strong>Điều khoản sử dụng</strong>
                    <small>Quy định dành cho thành viên</small>
                </span>
                <span class="text-muted">→</span>
            </a>
        </div>
    </aside>
</div>
