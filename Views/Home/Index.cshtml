@using EZ_Rent.Models
@using EZ_Rent.Models.Enums

@{
    ViewData["Title"] = "Trang chủ";

    var recs = ViewBag.Recommendations as List<RentalPost> ?? new List<RentalPost>();
    var newest = ViewBag.NewestPosts as List<RentalPost> ?? new List<RentalPost>();
    var topCities = ViewBag.TopCities as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    int totalPosts = ViewBag.TotalPosts ?? 0;
    int totalUsers = ViewBag.TotalUsers ?? 0;
    int totalLandlords = ViewBag.TotalLandlords ?? 0;
    int totalCities = ViewBag.TotalCities ?? 0;

    var isTenant = User.Identity?.IsAuthenticated == true && User.IsInRole("Tenant");
    var searchController = isTenant ? "RentalPost" : "RentalPost";
    var searchArea = isTenant ? "Tenant" : "";

    string RoomTypeLabel(RoomType type) => type switch
    {
        RoomType.Room => "Phòng trọ",
        RoomType.Apartment => "Căn hộ mini",
        RoomType.House => "Nhà nguyên căn",
        RoomType.Dormitory => "Ký túc xá / Ở ghép",
        _ => type.ToString()
    };
}

<!-- ================= 1. EDITORIAL DISCOVERY INTRO ================= -->
<section class="ez-discovery-intro">
    <div>
        <p class="eyebrow">TÌM NƠI Ở PHÙ HỢP</p>
        <h1>Phòng mới, khởi đầu mới.</h1>
        <p>Khám phá những không gian còn trống với giá thuê, điện, nước và dịch vụ minh bạch ngay từ đầu.</p>
    </div>
    <div class="ez-discovery-stats" aria-label="Thống kê hệ thống">
        <div class="ez-discovery-stat">
            <strong>@totalPosts</strong>
            <span>Phòng đang mở</span>
        </div>
        <div class="ez-discovery-stat">
            <strong>@totalLandlords</strong>
            <span>Chủ nhà</span>
        </div>
        <div class="ez-discovery-stat">
            <strong>@totalCities</strong>
            <span>Tỉnh / Thành phố</span>
        </div>
    </div>
</section>

<!-- ================= 2. UNIFIED HORIZONTAL SEARCH SURFACE ================= -->
<section class="ez-search-surface" aria-label="Tra cứu phòng cho thuê">
    <form asp-area="" asp-controller="RentalPost" asp-action="Index" method="get">
        <div class="ez-search-grid">
            <div>
                <label class="form-label" for="home-keyword">Từ khóa hoặc địa chỉ</label>
                <input id="home-keyword" type="text" name="search" class="form-control"
                       placeholder="Tên đường, quận/huyện, trường đại học…" />
            </div>
            <div>
                <label class="form-label" for="home-city">Tỉnh / Thành phố</label>
                <select id="home-city" name="city" class="form-select">
                    <option value="">Tất cả khu vực</option>
                    <option value="Hà Nội">Hà Nội</option>
                    <option value="TP. Hồ Chí Minh">TP. Hồ Chí Minh</option>
                    <option value="Đà Nẵng">Đà Nẵng</option>
                    <option value="Cần Thơ">Cần Thơ</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="home-type">Loại phòng</label>
                <select id="home-type" name="roomType" class="form-select">
                    <option value="">Tất cả loại phòng</option>
                    @foreach (RoomType t in Enum.GetValues(typeof(RoomType)))
                    {
                        <option value="@((int)t)">@RoomTypeLabel(t)</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" for="home-price">Mức giá tối đa</label>
                <select id="home-price" name="maxPrice" class="form-select">
                    <option value="">Không giới hạn</option>
                    <option value="3000000">Đến 3.000.000 đ / tháng</option>
                    <option value="5000000">Đến 5.000.000 đ / tháng</option>
                    <option value="8000000">Đến 8.000.000 đ / tháng</option>
                    <option value="12000000">Đến 12.000.000 đ / tháng</option>
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-primary w-100" style="min-height: 42px; padding: 9px 20px;">
                    Tìm phòng
                </button>
            </div>
        </div>
    </form>

    @if (topCities.Any())
    {
        <div class="ez-chip-row" aria-label="Khu vực phổ biến">
            <span class="text-muted small me-1">Khu vực nhiều phòng:</span>
            @foreach (var city in topCities)
            {
                string cityName = city.City;
                int count = city.Count;
                <a asp-area="@searchArea" asp-controller="@searchController" asp-action="Index"
                   asp-route-city="@cityName"
                   class="ez-filter-chip">
                    <span>@cityName</span>
                    <span class="text-muted fw-normal num">(@count)</span>
                </a>
            }
        </div>
    }
</section>

<!-- ================= 3A. GỢI Ý DÀNH RIÊNG CHO TENANT ================= -->
@if (isTenant && recs.Any())
{
    <section class="mb-5" aria-labelledby="home-recs-heading">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
            <div>
                <p class="eyebrow">DÀNH CHO BẠN</p>
                <h2 id="home-recs-heading" class="mb-0">Gợi ý dựa trên nhu cầu của bạn</h2>
            </div>
            <a asp-area="Tenant" asp-controller="RentalPost" asp-action="Index" class="small fw-semibold">
                Mở trang tìm phòng người thuê →
            </a>
        </div>

        <div class="ez-rental-grid">
            @foreach (var post in recs)
            {
                var thumb = post.RoomImages?.FirstOrDefault(i => i.IsPrimary)?.MediaUrl
                            ?? post.RoomImages?.FirstOrDefault()?.MediaUrl
                            ?? "/images/room-placeholder.svg";

                <article class="ez-rental-card">
                    <a asp-area="Tenant" asp-controller="RentalPost" asp-action="Details" asp-route-id="@post.RentalPostId"
                       class="ez-card-photo" aria-label="Xem @post.Title">
                        <img src="@thumb" alt="@post.Title" loading="lazy" />
                        <span class="ez-room-badge">@RoomTypeLabel(post.RoomType)</span>
                    </a>
                    <div class="ez-card-copy">
                        <div class="ez-card-price">
                            <strong>@post.Price.ToString("N0") đ</strong>
                            <span>/ tháng</span>
                        </div>
                        <h3>
                            <a asp-area="Tenant" asp-controller="RentalPost" asp-action="Details" asp-route-id="@post.RentalPostId">
                                @post.Title
                            </a>
                        </h3>
                        <p class="ez-card-address">@post.Address, @post.District, @post.City</p>
                        <div class="ez-card-meta">
                            <span class="num">@post.Area.ToString("0.##") m²</span>
                            <span class="ez-available-dot">Còn trống</span>
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
}

<!-- ================= 3B. KHÔNG GIAN MỚI CẬP NHẬT ================= -->
@if (newest.Any())
{
    <section class="mb-5" aria-labelledby="home-newest-heading">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
            <div>
                <p class="eyebrow">KHÔNG GIAN ĐANG CHỜ BẠN</p>
                <h2 id="home-newest-heading" class="mb-0">Phòng mới cập nhật <span class="text-muted fw-normal fs-6">(@newest.Count)</span></h2>
            </div>
            <a asp-area="@searchArea" asp-controller="@searchController" asp-action="Index" class="small fw-semibold">
                Xem toàn bộ phòng đang mở →
            </a>
        </div>

        <div class="ez-rental-grid">
            @foreach (var post in newest)
            {
                var thumb = post.RoomImages?.FirstOrDefault(i => i.IsPrimary)?.MediaUrl
                            ?? post.RoomImages?.FirstOrDefault()?.MediaUrl
                            ?? "/images/room-placeholder.svg";

                <article class="ez-rental-card">
                    <a asp-area="@searchArea" asp-controller="@searchController" asp-action="Details" asp-route-id="@post.RentalPostId"
                       class="ez-card-photo" aria-label="Xem @post.Title">
                        <img src="@thumb" alt="@post.Title" loading="lazy" />
                        <span class="ez-room-badge">@RoomTypeLabel(post.RoomType)</span>
                    </a>
                    <div class="ez-card-copy">
                        <div class="ez-card-price">
                            <strong>@post.Price.ToString("N0") đ</strong>
                            <span>/ tháng</span>
                        </div>
                        <h3>
                            <a asp-area="@searchArea" asp-controller="@searchController" asp-action="Details" asp-route-id="@post.RentalPostId">
                                @post.Title
                            </a>
                        </h3>
                        <p class="ez-card-address">@post.Address, @post.District, @post.City</p>
                        <div class="ez-card-meta">
                            <span class="num">@post.Area.ToString("0.##") m²</span>
                            <span class="ez-available-dot">Còn trống</span>
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
}

<!-- ================= 4. EDITORIAL READING & SHORTCUT RAIL (Matched to tenant-home.css) ================= -->
<section class="ez-editorial-layout" aria-label="Thông tin và tiện ích thuê phòng">
    <div>
        <div class="mb-3">
            <p class="eyebrow">KINH NGHIỆM THUÊ NHÀ</p>
            <h2 class="mb-1">Minh bạch từ lúc xem phòng đến khi nhận bàn giao</h2>
            <p class="text-muted small mb-0">Những điểm cần lưu ý để người thuê và chủ nhà làm việc rõ ràng, tránh phát sinh tranh chấp.</p>
        </div>

        <div class="row g-4 align-items-start mt-1">
            <div class="col-md-6">
                <article class="card overflow-hidden h-100">
                    <img src="~/images/brand/city-ong.png" alt="EZ-Rent - Không gian thuê trọ minh bạch" style="width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-bottom: 1px solid var(--ez-line);" loading="lazy" />
                    <div class="p-4">
                        <div class="text-muted small mb-2">Hợp đồng & Chi phí · 3 phút đọc</div>
                        <h3 class="mb-2">Kiểm tra đơn giá điện, nước và phí dịch vụ trước khi đặt cọc</h3>
                        <p class="text-muted small mb-3" style="line-height: 1.75;">
                            Mọi tin đăng trên EZ-Rent đều tách bạch tiền thuê phòng cố định với đơn giá điện (đ/kWh), nước (đ/m³) và phí dịch vụ chung. Khi nhận bàn giao, hai bên đối chiếu chỉ số công tơ đầu kỳ kèm ảnh chụp thực tế lưu trực tiếp vào hồ sơ hợp đồng.
                        </p>
                        <a asp-controller="RentalPost" asp-action="Index" class="small fw-semibold">
                            Tra cứu phòng có niêm yết phí rõ ràng →
                        </a>
                    </div>
                </article>
            </div>

            <div class="col-md-6">
                <div class="d-flex flex-column gap-3">
                    <article class="pb-3 border-bottom">
                        <div class="text-muted small mb-1">Lịch xem phòng</div>
                        <h3 class="h6 mb-1">Đặt lịch hẹn theo khung giờ chủ nhà mở cửa</h3>
                        <p class="text-muted small mb-0" style="line-height: 1.7;">
                            Chọn ngày giờ thuận tiện và nhận thông báo xác nhận ngay trên hệ thống, hoặc trao đổi trực tiếp qua hộp thư chung.
                        </p>
                    </article>

                    <article class="pb-3 border-bottom">
                        <div class="text-muted small mb-1">Hóa đơn & Điện nước</div>
                        <h3 class="h6 mb-1">Đối soát hóa đơn hàng tháng kèm ảnh công tơ</h3>
                        <p class="text-muted small mb-0" style="line-height: 1.7;">
                            Chủ trọ ghi chỉ số điện nước kèm ảnh minh chứng, hệ thống tự động tính thành tiền và tạo mã VietQR chuẩn xác.
                        </p>
                    </article>

                    <article>
                        <div class="text-muted small mb-1">Bảo trì & Sửa chữa</div>
                        <h3 class="h6 mb-1">Gửi yêu cầu sửa chữa có theo dõi tiến độ</h3>
                        <p class="text-muted small mb-0" style="line-height: 1.7;">
                            Khi thiết bị trong phòng gặp sự cố, người thuê gửi báo cáo kèm mức độ ưu tiên để chủ nhà và quản trị viên phối hợp xử lý.
                        </p>
                    </article>
                </div>
            </div>
        </div>
    </div>

    <aside class="ez-editorial-aside" aria-label="Lối tắt hệ thống">
        <h2 class="h6 mb-2">Dành cho bạn</h2>
        <div>
            <a asp-area="@searchArea" asp-controller="@searchController" asp-action="Index" class="ez-plain-row">
                <span>
                    <strong>Tìm phòng đang trống</strong>
                    <small>Lọc theo khu vực, diện tích và ngân sách</small>
                </span>
                <span class="text-muted">→</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-area="" asp-controller="Chat" asp-action="Index" class="ez-plain-row">
                    <span>
                        <strong>Hộp thư tin nhắn</strong>
                        <small>Trao đổi trực tiếp giữa người thuê & chủ nhà</small>
                    </span>
                    <span class="text-muted">→</span>
                </a>
            }

            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Landlord"))
            {
                <a asp-area="Landlord" asp-controller="Overview" asp-action="Index" class="ez-plain-row">
                    <span>
                        <strong>Bảng điều khiển Chủ trọ</strong>
                        <small>Quản lý phòng, hợp đồng, điện nước và hóa đơn</small>
                    </span>
                    <span class="text-muted">→</span>
                </a>
            }
            else if (User.Identity?.IsAuthenticated == true && User.IsInRole("Tenant"))
            {
                <a asp-area="Tenant" asp-controller="Dashboard" asp-action="Index" class="ez-plain-row">
                    <span>
                        <strong>Không gian Người thuê</strong>
                        <small>Theo dõi lịch hẹn, phòng đang ở và hóa đơn</small>
                    </span>
                    <span class="text-muted">→</span>
                </a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="ez-plain-row">
                    <span>
                        <strong>Đăng nhập hệ thống</strong>
                        <small>Quản lý lịch xem phòng, hợp đồng và hóa đơn</small>
                    </span>
                    <span class="text-muted">→</span>
                </a>
                <a asp-area="Identity" asp-page="/Account/Register" class="ez-plain-row">
                    <span>
                        <strong>Đăng ký tài khoản mới</strong>
                        <small>Dành cho người tìm thuê phòng hoặc chủ nhà</small>
                    </span>
                    <span class="text-muted">→</span>
                </a>
            }
        </div>
    </aside>
</section>
