@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@using EZ_Rent.Areas.Tenant.ViewModels
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var tenant = area == "Tenant";
    var landlord = area == "Landlord";
    var admin = area == "Admin";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var chat = (tenant && controller == "Dashboard" && action == "Messages")
        || (landlord && controller == "Messages")
        || (string.IsNullOrEmpty(area) && controller == "Chat");
    var rental = tenant && controller is "MyRoom" or "Contract" or "Invoice" or "RepairRequest";
    var discovery = tenant && controller is "RentalPost" or "Favorite" or "ViewingAppointment" or "ViewingBooking";
    var surfaceClass = chat ? "main tenant-chat" : "discovery-main home-page";
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EZ-Rent</title>
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EZ_Rent.styles.css" asp-append-version="true" />
    @if (tenant) {
        @if (chat) { <link rel="stylesheet" href="~/css/tenant-messages.css" asp-append-version="true" /> }
        else {
            <link rel="stylesheet" href="~/css/tenant-discovery.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/tenant-home.css" asp-append-version="true" />
            @if (discovery) { <link rel="stylesheet" href="~/css/tenant-appointments.css" asp-append-version="true" /> }
            @if (controller == "ViewingBooking") { <link rel="stylesheet" href="~/css/tenant-booking.css" asp-append-version="true" /> }
            @if (rental) { <link rel="stylesheet" href="~/css/tenant-rental.css" asp-append-version="true" /> }
            @if (action is "Draft" or "DraftHistory") { <link rel="stylesheet" href="~/css/tenant-contract-draft.css" asp-append-version="true" /> }
            @if (controller == "Account") { <link rel="stylesheet" href="~/css/tenant-account.css" asp-append-version="true" /> }
            @if (controller == "Support") { <link rel="stylesheet" href="~/css/tenant-support.css" asp-append-version="true" /> }
        }
    }
    @if (tenant || chat) { <link rel="stylesheet" href="~/css/tenant-integration.css" asp-append-version="true" /> }
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(tenant ? "tenant-app" : chat ? "landlord-chat-app" : null)">
    @if (HostEnvironment.EnvironmentName == "Demo") { <div class="alert alert-info text-center rounded-0 py-1 mb-0 small">Bản demo dùng dataset của nhóm · Dữ liệu thử riêng</div> }
    <!-- ================= HEADER ================= -->
    <header id="shared-header" class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid navbar-container">

                <!-- ===== Logo ===== -->
                <a class="navbar-brand ez-brand" asp-area="@(User.IsInRole("Tenant") ? "Tenant" : "")" asp-controller="@(User.IsInRole("Tenant") ? "Dashboard" : "Home")" asp-action="Index">
                    <img src="~/images/brand/logo-icon.png" alt="EZ-Rent Logo" class="ez-brand-logo" />
                    <span class="ez-brand-wordmark"><span class="ez-brand-ez">ez</span><span class="ez-brand-rent">rent</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-label="Mở menu điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">

                    <!-- ================= MAIN MENU (Clean Text Links like Tenant) ================= -->
                    <ul class="navbar-nav flex-grow-1 gap-lg-1">

                        <li class="nav-item">
                            <a class="nav-link"
                               aria-current="@((string.IsNullOrEmpty(area) && controller == "Home") || (tenant && controller == "Dashboard" && action == "Index") ? "page" : null)"
                               asp-area="@(User.IsInRole("Tenant") ? "Tenant" : "")"
                               asp-controller="@(User.IsInRole("Tenant") ? "Dashboard" : "Home")"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               aria-current="@((tenant && controller is "RentalPost" or "ViewingBooking") || (string.IsNullOrEmpty(area) && controller == "RentalPost") ? "page" : null)"
                               asp-area="@(User.IsInRole("Tenant") ? "Tenant" : "")"
                               asp-controller="RentalPost"
                               asp-action="Index">
                                Tìm phòng
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   aria-current="@(chat ? "page" : null)"
                                   asp-area=""
                                   asp-controller="Chat"
                                   asp-action="Index">
                                    Tin nhắn
                                </a>
                            </li>

                            <!-- DROPDOWN TENANT -->
                            @if (User.IsInRole("Tenant"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        Người thuê
                                    </a>
                                    @await Html.PartialAsync("~/Areas/Tenant/Views/Shared/_TenantSharedMenu.cshtml")
                                </li>
                            }

                            <!-- MENU CHỦ TRỌ: dàn ra theo nhóm, mục liên quan nằm chung một chỗ -->
                            @if (User.IsInRole("Landlord"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @(landlord && controller is "Overview" or "Repairs" or "Support" ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown">
                                        Tổng quan
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Overview" asp-action="Index">Bảng tổng quan</a></li>
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Repairs" asp-action="Index">Yêu cầu sửa chữa</a></li>
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Support" asp-action="Index">Hỗ trợ từ quản trị viên</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @(landlord && controller is "Rooms" or "RoomMedia" or "Viewings" or "ViewingHours" ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown">
                                        Phòng trọ
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Rooms" asp-action="Index">Danh sách phòng</a></li>
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Rooms" asp-action="Create">Đăng tin mới</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Viewings" asp-action="Index">Lịch xem phòng</a></li>
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="ViewingHours" asp-action="Index">Khung giờ nhận khách</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @(landlord && controller is "Contracts" or "ContractDocuments" or "MeterReadings" or "Invoices" or "InvoicePayments" or "PaymentSettings" ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown">
                                        Hợp đồng
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Contracts" asp-action="Index">Hợp đồng</a></li>
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="MeterReadings" asp-action="Index">Điện, nước</a></li>
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Invoices" asp-action="Index">Hóa đơn</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="Landlord" asp-controller="PaymentSettings" asp-action="Index">Tài khoản nhận tiền</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(landlord && controller == "Account" ? "active" : null)" asp-area="Landlord" asp-controller="Account" asp-action="Index">Tài khoản</a>
                                </li>
                            }

                            <!-- DROPDOWN ADMIN -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @(admin ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown">
                                        Quản trị
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Tổng quan hệ thống</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Post" asp-action="Index">Kiểm duyệt tin đăng</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="UserManager" asp-action="Index">Quản lý người dùng</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="RoleManager" asp-action="Index">Quản lý vai trò</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Support" asp-action="Index">Khiếu nại sửa chữa</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="DbManage" asp-action="Index">Quản lý CSDL</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <!-- ================= ACCOUNT ================= -->
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Tenant"))
                            {
                                <a asp-area="Tenant"
                                   asp-controller="Account"
                                   asp-action="Index"
                                   class="ez-account-icon-btn"
                                   title="@User.Identity.Name"
                                   aria-label="Tài khoản của tôi">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M5 21v-3a7 7 0 0 1 14 0v3M16 6a4 4 0 1 1-8 0 4 4 0 0 1 8 0" />
                                    </svg>
                                </a>
                            }
                            else
                            {
                                <a asp-area="Identity"
                                   asp-page="/Account/Manage/Index"
                                   class="ez-account-icon-btn"
                                   title="@User.Identity.Name"
                                   aria-label="Tài khoản của tôi">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M5 21v-3a7 7 0 0 1 14 0v3M16 6a4 4 0 1 1-8 0 4 4 0 0 1 8 0" />
                                    </svg>
                                </a>
                            }
                            <span class="d-none">@Html.AntiForgeryToken()</span>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">
                                Đăng nhập
                            </a>

                            <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">
                                Đăng ký
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ================= MAIN ================= -->
    <div class="@(tenant || chat ? "container-fluid tenant-container" : "ez-app-container")">
        <main id="main" role="main" class="pb-3 @(tenant ? "tenant-surface " + surfaceClass : chat ? "landlord-chat-surface" : "")">
            @if (tenant) { @await Html.PartialAsync("~/Areas/Tenant/Views/Shared/_TenantFeedback.cshtml") }
            @if (rental) { @await Html.PartialAsync("~/Areas/Tenant/Views/Shared/_TenantRentalNavigation.cshtml") }
            <div class="@(rental ? "rental-page" : null)">@RenderBody()</div>
        </main>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="footer ez-footer">
        <div class="ez-footer-inner">
            <!-- TIER 1: BRAND + SEARCH BAR -->
            <div class="ez-footer-top">
                <a class="ez-footer-brand" asp-area="@(User.IsInRole("Tenant") ? "Tenant" : "")" asp-controller="@(User.IsInRole("Tenant") ? "Dashboard" : "Home")" asp-action="Index">
                    <span class="ez-brand-wordmark" style="font-size: 22px;"><span class="ez-brand-ez">ez</span><span class="ez-brand-rent">rent</span></span>
                </a>

                <form class="ez-footer-search" asp-area="@(User.IsInRole("Tenant") ? "Tenant" : "")" asp-controller="RentalPost" asp-action="Index" method="get">
                    <span class="ez-footer-search-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </span>
                    <input type="text" name="Keyword" placeholder="Nhập khu vực, đường phố hoặc tên phòng cần tìm..." aria-label="Tìm nhanh phòng trọ" />
                    <button type="submit">Tìm kiếm</button>
                </form>
            </div>

            <!-- TIER 2: 4 COLUMNS -->
            <div class="ez-footer-columns">
                <div class="ez-footer-col">
                    <h6>Khám phá phòng trọ</h6>
                    <ul class="ez-footer-links">
                        <li><a asp-area="@(User.IsInRole("Tenant") ? "Tenant" : "")" asp-controller="RentalPost" asp-action="Index">Tìm phòng đang trống</a></li>
                        <li><a asp-area="" asp-controller="RentalPost" asp-action="Index" asp-route-City="Hà Nội">Phòng trọ tại Hà Nội</a></li>
                        <li><a asp-area="" asp-controller="RentalPost" asp-action="Index" asp-route-City="TP. Hồ Chí Minh">Phòng trọ tại TP. Hồ Chí Minh</a></li>
                        <li><a asp-area="" asp-controller="RentalPost" asp-action="Index" asp-route-City="Đà Nẵng">Phòng trọ tại Đà Nẵng</a></li>
                    </ul>
                </div>

                <div class="ez-footer-col">
                    <h6>Dịch vụ &amp; Tiện ích</h6>
                    <ul class="ez-footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Guide" asp-fragment="booking">Đặt lịch hẹn xem phòng</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Guide" asp-fragment="contract">Hợp đồng điện tử chuẩn BM03</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Guide" asp-fragment="billing">Đối soát điện nước &amp; VietQR</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Guide" asp-fragment="repair">Báo cáo &amp; theo dõi sửa chữa</a></li>
                    </ul>
                </div>

                <div class="ez-footer-col">
                    <h6>Hỗ trợ &amp; Chính sách</h6>
                    <ul class="ez-footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Guide">Cẩm nang thuê phòng</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Help">Trung tâm trợ giúp (FAQ)</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Terms">Điều khoản sử dụng</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                    </ul>
                </div>

                <div class="ez-footer-col">
                    <h6>Kết nối với chúng tôi</h6>
                    <p class="ez-footer-join-label">Theo dõi EZ-Rent</p>
                    <div class="ez-footer-socials">
                        <a href="https://www.facebook.com/otungduong.90944/" target="_blank" rel="noopener noreferrer" class="ez-footer-social-link" aria-label="Facebook" title="Facebook">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M15.12 5.32H17V2.14A26.11 26.11 0 0 0 14.26 2c-2.72 0-4.58 1.66-4.58 4.7v2.62H6.61v3.56h3.07V22h3.68v-9.12h3.06l.46-3.56h-3.52V6.65c0-1.05.29-1.73 1.76-1.73Z"/>
                            </svg>
                        </a>
                        <a href="https://www.instagram.com/dt.duong05_/" target="_blank" rel="noopener noreferrer" class="ez-footer-social-link" aria-label="Instagram" title="Instagram">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3Z"/>
                            </svg>
                        </a>
                        <a href="https://www.linkedin.com/login/vi" target="_blank" rel="noopener noreferrer" class="ez-footer-social-link" aria-label="LinkedIn" title="LinkedIn">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z"/>
                            </svg>
                        </a>
                    </div>
                    <div class="small text-muted">
                        Hotline: <strong class="num text-dark">1900 6868</strong><br />
                        Email: <strong class="text-dark">support@ezrent.vn</strong>
                    </div>
                </div>
            </div>

            <!-- TIER 3: COPYRIGHT + BOTTOM NAV -->
            <div class="ez-footer-bottom">
                <div>
                    EZ-Rent &copy; 2026. Bảo lưu mọi quyền · Nhóm WNC.G07.
                </div>
                <nav class="ez-footer-bottom-nav" aria-label="Liên kết chân trang">
                    <a asp-area="@(User.IsInRole("Tenant") ? "Tenant" : "")" asp-controller="@(User.IsInRole("Tenant") ? "Dashboard" : "Home")" asp-action="Index">Trang chủ</a>
                    <a asp-area="@(User.IsInRole("Tenant") ? "Tenant" : "")" asp-controller="RentalPost" asp-action="Index">Dịch vụ tìm phòng</a>
                    <a asp-area="" asp-controller="Home" asp-action="Guide">Cẩm nang</a>
                    <a asp-area="" asp-controller="Home" asp-action="Help">Trung tâm trợ giúp</a>
                    <a asp-area="" asp-controller="Home" asp-action="About">Về chúng tôi</a>
                </nav>
            </div>
        </div>
    </footer>

    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (tenant) {
        <script src="~/js/tenant-shell.js" asp-append-version="true" defer></script>
        @if (chat) { <script src="~/js/tenant-messages.js" asp-append-version="true" defer></script> }
        else {
            <script src="~/js/tenant-home.js" asp-append-version="true" defer></script>
            @if (discovery) { <script src="~/js/tenant-discovery.js" asp-append-version="true" defer></script> }
            @if (controller == "ViewingBooking") { <script src="~/js/tenant-booking.js" asp-append-version="true" defer></script> }
            @if (rental) { <script src="~/js/tenant-rental.js" asp-append-version="true" defer></script> }
        }
    }
    @if (chat) {
        <script src="~/lib/signalr/signalr.min.js" asp-append-version="true" defer></script>
        <script src="~/js/chat-realtime.js" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
