@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using EZ_Rent.Areas.Tenant.ViewModels
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject EZ_Rent.Data.AppDbContext Db
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var tenant = area == "Tenant";
    var landlord = area == "Landlord";
    var admin = area == "Admin";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var chat = (tenant && controller == "Dashboard" && action == "Messages")
        || (landlord && controller == "Messages")
        || (string.IsNullOrEmpty(area) && controller == "Chat");
    var rental = tenant && controller is "MyRoom" or "Contract" or "Invoice" or "RepairRequest";
    var discovery = tenant && controller is "RentalPost" or "Favorite" or "ViewingAppointment" or "ViewingBooking";
    var surfaceClass = chat ? "main tenant-chat" : "discovery-main home-page";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isTenantRole = isAuthenticated && User.IsInRole("Tenant");
    var isLandlordRole = isAuthenticated && User.IsInRole("Landlord");
    var isAdminRole = isAuthenticated && User.IsInRole("Admin");

    var unreadHeaderCount = 0;
    if (isTenantRole)
    {
        if (ViewData["UnreadNotifications"] is int cachedUnread)
        {
            unreadHeaderCount = cachedUnread;
        }
        else
        {
            var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (!string.IsNullOrEmpty(currentUserId))
            {
                unreadHeaderCount = await Db.Notifications.CountAsync(n => n.UserId == currentUserId && !n.IsRead);
            }
        }
    }
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EZ-Rent</title>
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EZ_Rent.styles.css" asp-append-version="true" />
    @if (tenant) {
        @if (chat) { <link rel="stylesheet" href="~/css/tenant-messages.css" asp-append-version="true" /> }
        else {
            <link rel="stylesheet" href="~/css/tenant-discovery.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/tenant-home.css" asp-append-version="true" />
            @if (discovery) { <link rel="stylesheet" href="~/css/tenant-appointments.css" asp-append-version="true" /> }
            @if (controller == "ViewingBooking") { <link rel="stylesheet" href="~/css/tenant-booking.css" asp-append-version="true" /> }
            @if (rental) { <link rel="stylesheet" href="~/css/tenant-rental.css" asp-append-version="true" /> }
            @if (action is "Draft" or "DraftHistory") { <link rel="stylesheet" href="~/css/tenant-contract-draft.css" asp-append-version="true" /> }
            @if (controller == "Account") { <link rel="stylesheet" href="~/css/tenant-account.css" asp-append-version="true" /> }
            @if (controller == "Support") { <link rel="stylesheet" href="~/css/tenant-support.css" asp-append-version="true" /> }
        }
    }
    @if (tenant || chat) { <link rel="stylesheet" href="~/css/tenant-integration.css" asp-append-version="true" /> }
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(tenant ? "tenant-app" : chat ? "landlord-chat-app" : null)">
    @if (HostEnvironment.EnvironmentName == "Demo") { <div class="alert alert-info text-center rounded-0 py-1 mb-0 small">Bản demo dùng dataset của nhóm · Dữ liệu thử riêng</div> }
    <!-- ================= HEADER (3-ZONE SYMMETRICAL CENTERED NAV) ================= -->
    <header id="shared-header" class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid navbar-container">

                <!-- ===== Left: Brand Logo ===== -->
                <a class="navbar-brand ez-brand"
                   asp-area="@(isTenantRole ? "Tenant" : "")"
                   asp-controller="@(isTenantRole ? "Dashboard" : "Home")"
                   asp-action="Index">
                    <img src="~/images/brand/logo-icon.png" alt="EZ-Rent Logo" class="ez-brand-logo" />
                    <span class="ez-brand-wordmark"><span class="ez-brand-ez">ez</span><span class="ez-brand-rent">rent</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-label="Mở menu điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- ===== Center Nav + Right Tools ===== -->
                <div class="navbar-collapse collapse ez-header-right">

                    <ul class="navbar-nav ez-header-nav">
                        @if (isTenantRole)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   aria-current="@(tenant && controller == "Dashboard" && action == "Index" ? "page" : null)"
                                   asp-area="Tenant"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Trang chủ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   aria-current="@(tenant && controller is "RentalPost" or "ViewingBooking" or "ViewingAppointment" ? "page" : null)"
                                   asp-area="Tenant"
                                   asp-controller="RentalPost"
                                   asp-action="Index">
                                    Tìm phòng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   aria-current="@(chat ? "page" : null)"
                                   asp-area=""
                                   asp-controller="Chat"
                                   asp-action="Index">
                                    Tin nhắn
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   aria-current="@(rental ? "page" : null)"
                                   asp-area="Tenant"
                                   asp-controller="MyRoom"
                                   asp-action="Index">
                                    Phòng đang ở
                                </a>
                            </li>
                        }
                        else if (isLandlordRole)
                        {
                            <!-- MENU CHỦ TRỌ: dàn ra theo nhóm, mục liên quan nằm chung một chỗ -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(landlord && controller is "Overview" or "Repairs" or "Support" ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown">
                                    Tổng quan
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Overview" asp-action="Index">Bảng tổng quan</a></li>
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Repairs" asp-action="Index">Yêu cầu sửa chữa</a></li>
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Support" asp-action="Index">Hỗ trợ từ quản trị viên</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(landlord && controller is "Rooms" or "RoomMedia" or "Viewings" or "ViewingHours" ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown">
                                    Phòng trọ
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Rooms" asp-action="Index">Danh sách phòng</a></li>
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Rooms" asp-action="Create">Đăng tin mới</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Viewings" asp-action="Index">Lịch xem phòng</a></li>
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="ViewingHours" asp-action="Index">Khung giờ nhận khách</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(landlord && controller is "Contracts" or "ContractDocuments" or "MeterReadings" or "Invoices" or "InvoicePayments" or "PaymentSettings" ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown">
                                    Hợp đồng
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Contracts" asp-action="Index">Hợp đồng</a></li>
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="MeterReadings" asp-action="Index">Điện, nước</a></li>
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="Invoices" asp-action="Index">Hóa đơn</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="Landlord" asp-controller="PaymentSettings" asp-action="Index">Tài khoản nhận tiền</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(landlord && controller == "Account" ? "active" : null)" asp-area="Landlord" asp-controller="Account" asp-action="Index">Tài khoản</a>
                            </li>
                        }
                        else if (isAdminRole)
                        {
                            <!-- DROPDOWN ADMIN -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(admin ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown">
                                    Quản trị
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Tổng quan hệ thống</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Post" asp-action="Index">Kiểm duyệt tin đăng</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="UserManager" asp-action="Index">Quản lý người dùng</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="RoleManager" asp-action="Index">Quản lý vai trò</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Support" asp-action="Index">Khiếu nại sửa chữa</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="DbManage" asp-action="Index">Quản lý CSDL</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   aria-current="@(string.IsNullOrEmpty(area) && controller == "Home" && action == "Index" ? "page" : null)"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Trang chủ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   aria-current="@(string.IsNullOrEmpty(area) && controller == "RentalPost" ? "page" : null)"
                                   asp-area=""
                                   asp-controller="RentalPost"
                                   asp-action="Index">
                                    Tìm phòng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   aria-current="@(string.IsNullOrEmpty(area) && controller == "Home" && action == "Guide" ? "page" : null)"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Guide">
                                    Cẩm nang
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   aria-current="@(string.IsNullOrEmpty(area) && controller == "Home" && action == "About" ? "page" : null)"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="About">
                                    Về chúng tôi
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- ================= RIGHT: USER TOOLS / PILL CTA ================= -->
                    <div class="ez-header-tools">
                        @if (isAuthenticated)
                        {
                            @if (isTenantRole)
                            {
                                <a asp-area="Tenant"
                                   asp-controller="Favorite"
                                   asp-action="Index"
                                   class="ez-account-icon-btn @(tenant && controller == "Favorite" ? "is-active" : null)"
                                   aria-current="@(tenant && controller == "Favorite" ? "page" : null)"
                                   title="Phòng yêu thích"
                                   aria-label="Phòng yêu thích">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                    </svg>
                                </a>

                                <a asp-area="Tenant"
                                   asp-controller="Notification"
                                   asp-action="Index"
                                   class="ez-account-icon-btn @(tenant && controller == "Notification" ? "is-active" : null)"
                                   aria-current="@(tenant && controller == "Notification" ? "page" : null)"
                                   title="Thông báo"
                                   aria-label="Thông báo, @unreadHeaderCount chưa đọc">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                                    </svg>
                                    @if (unreadHeaderCount > 0)
                                    {
                                        <span class="ez-header-bell-badge" aria-hidden="true">@(unreadHeaderCount > 99 ? "99+" : unreadHeaderCount.ToString())</span>
                                    }
                                </a>

                                <div class="dropdown ez-user-dropdown">
                                    <button class="ez-account-icon-btn @(tenant && controller is "Account" or "Support" ? "is-active" : null)"
                                            type="button"
                                            id="ezTenantUserMenu"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            title="@User.Identity!.Name"
                                            aria-label="Tài khoản của tôi">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M5 21v-3a7 7 0 0 1 14 0v3M16 6a4 4 0 1 1-8 0 4 4 0 0 1 8 0" />
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end ez-user-dropdown-menu" aria-labelledby="ezTenantUserMenu">
                                        <li class="ez-user-dropdown-header">
                                            <div class="ez-user-dropdown-name">@User.Identity!.Name</div>
                                            <div class="ez-user-dropdown-role">Người thuê</div>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item ez-user-dropdown-item @(tenant && controller == "Account" && action == "Index" ? "active" : null)"
                                               asp-area="Tenant" asp-controller="Account" asp-action="Index">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                    <circle cx="12" cy="7" r="4"></circle>
                                                </svg>
                                                <span>Thông tin cá nhân</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item ez-user-dropdown-item @(tenant && controller == "Account" && action == "Security" ? "active" : null)"
                                               asp-area="Tenant" asp-controller="Account" asp-action="Security">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                                </svg>
                                                <span>Bảo mật &amp; đăng nhập</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item ez-user-dropdown-item @(tenant && controller == "Support" ? "active" : null)"
                                               asp-area="Tenant" asp-controller="Support" asp-action="Create">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                                </svg>
                                                <span>Hỗ trợ &amp; phản ánh</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-area="Tenant" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                                <button type="submit" class="dropdown-item ez-user-dropdown-item ez-user-logout-item">
                                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                                        <polyline points="16 17 21 12 16 7"></polyline>
                                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                                    </svg>
                                                    <span>Đăng xuất</span>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                @if (isLandlordRole)
                                {
                                    <a asp-area="Landlord"
                                       asp-controller="Rooms"
                                       asp-action="Create"
                                       class="ez-header-pill-cta ez-header-pill-sm">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <line x1="12" y1="5" x2="12" y2="19"></line>
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                        </svg>
                                        <span>Đăng phòng</span>
                                    </a>
                                }

                                <div class="dropdown ez-user-dropdown">
                                    <button class="ez-account-icon-btn"
                                            type="button"
                                            id="ezManageUserMenu"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            title="@User.Identity!.Name"
                                            aria-label="Tài khoản của tôi">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M5 21v-3a7 7 0 0 1 14 0v3M16 6a4 4 0 1 1-8 0 4 4 0 0 1 8 0" />
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end ez-user-dropdown-menu" aria-labelledby="ezManageUserMenu">
                                        <li class="ez-user-dropdown-header">
                                            <div class="ez-user-dropdown-name">@User.Identity!.Name</div>
                                            <div class="ez-user-dropdown-role">@(isLandlordRole ? "Chủ trọ" : "Quản trị viên")</div>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item ez-user-dropdown-item"
                                               asp-area="Identity" asp-page="/Account/Manage/Index">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                    <circle cx="12" cy="7" r="4"></circle>
                                                </svg>
                                                <span>Hồ sơ tài khoản</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item ez-user-dropdown-item"
                                               asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                                </svg>
                                                <span>Đổi mật khẩu</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="m-0">
                                                <button type="submit" class="dropdown-item ez-user-dropdown-item ez-user-logout-item">
                                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                                        <polyline points="16 17 21 12 16 7"></polyline>
                                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                                    </svg>
                                                    <span>Đăng xuất</span>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            <span class="d-none">@Html.AntiForgeryToken()</span>
                        }
                        else
                        {
                            <a class="ez-header-signin-link" asp-area="Identity" asp-page="/Account/Login">
                                Đăng nhập
                            </a>

                            <a class="ez-header-pill-cta" asp-area="Identity" asp-page="/Account/Register">
                                Đăng ký
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ================= MAIN ================= -->
    <div class="@(tenant || chat ? "container-fluid tenant-container" : "ez-app-container")">
        <main id="main" role="main" class="pb-3 @(tenant ? "tenant-surface " + surfaceClass : chat ? "landlord-chat-surface" : "")">
            @if (tenant) { @await Html.PartialAsync("~/Areas/Tenant/Views/Shared/_TenantFeedback.cshtml") }
            @if (rental) { @await Html.PartialAsync("~/Areas/Tenant/Views/Shared/_TenantRentalNavigation.cshtml") }
            <div class="@(rental ? "rental-page" : null)">@RenderBody()</div>
        </main>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="footer ez-footer">
        <div class="ez-footer-inner">
            <!-- TIER 1: BRAND + SEARCH BAR -->
            <div class="ez-footer-top">
                <a class="ez-footer-brand" asp-area="@(isTenantRole ? "Tenant" : "")" asp-controller="@(isTenantRole ? "Dashboard" : "Home")" asp-action="Index">
                    <span class="ez-brand-wordmark" style="font-size: 22px;"><span class="ez-brand-ez">ez</span><span class="ez-brand-rent">rent</span></span>
                </a>

                <form class="ez-footer-search" asp-area="@(isTenantRole ? "Tenant" : "")" asp-controller="RentalPost" asp-action="Index" method="get">
                    <span class="ez-footer-search-icon" aria-hidden="true">
