
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EZ-Rent</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EZ_Rent.styles.css" asp-append-version="true" />
</head>

<body>
    <!-- ================= HEADER ================= -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- ===== Logo ===== -->
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    🏠 EZ-Rent
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">

                    <!-- ================= MAIN MENU ================= -->
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Trang chủ -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <!-- Tìm phòng -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="RentalPost" asp-action="Index">
                                🔍 Tìm phòng
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- ============================================ -->
                            <!-- DROPDOWN TENANT                              -->
                            <!-- ============================================ -->
                            @if (User.IsInRole("Tenant"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                       data-bs-toggle="dropdown">
                                        🏡 Người thuê
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-area="Tenant" asp-controller="Dashboard"
                                               asp-action="Index">
                                                📊 Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Tenant" asp-controller="Favorite"
                                               asp-action="Index">
                                                ❤️ Phòng yêu thích
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Tenant" asp-controller="ViewingAppointment"
                                               asp-action="Index">
                                                📅 Lịch xem phòng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Tenant" asp-controller="Contract"
                                               asp-action="Index">
                                                📄 Hợp đồng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Tenant" asp-controller="Invoice"
                                               asp-action="Index">
                                                💰 Hóa đơn
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Tenant" asp-controller="RepairRequest"
                                               asp-action="Index">
                                                🔧 Yêu cầu sửa chữa
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            <!-- ============================================ -->
                            <!-- DROPDOWN LANDLORD                            -->
                            <!-- ============================================ -->
                            @if (User.IsInRole("Landlord"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                       data-bs-toggle="dropdown">
                                        🏠 Chủ trọ
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-area="Landlord" asp-controller="Dashboard"
                                               asp-action="Index">
                                                📊 Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-area="Landlord" asp-controller="Post"
                                               asp-action="Index">
                                                🏘️ Quản lý phòng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Landlord" asp-controller="RoomImage"
                                               asp-action="Index">
                                                🖼️ Ảnh / Video phòng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Landlord" asp-controller="Service"
                                               asp-action="Index">
                                                🧾 Phí dịch vụ
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Landlord" asp-controller="ViewingAppointment"
                                               asp-action="Index">
                                                📅 Lịch xem phòng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Landlord" asp-controller="Contract"
                                               asp-action="Index">
                                                📄 Hợp đồng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Landlord" asp-controller="MeterReading"
                                               asp-action="Index">
                                                ⚡ Điện nước
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Landlord" asp-controller="Invoice"
                                               asp-action="Index">
                                                💰 Hóa đơn
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Landlord" asp-controller="RepairRequest"
                                               asp-action="Index">
                                                🔧 Yêu cầu sửa chữa
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            <!-- ============================================ -->
                            <!-- DROPDOWN ADMIN                               -->
                            <!-- ============================================ -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                       data-bs-toggle="dropdown">
                                        🛡️ Quản trị
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard"
                                               asp-action="Index">
                                                📊 Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="Post" asp-action="Index">
                                                📝 Kiểm duyệt tin đăng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="UserManager"
                                               asp-action="Index">
                                                👥 Quản lý người dùng
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="RoleManager"
                                               asp-action="Index">
                                                🎭 Quản lý vai trò
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="Support"
                                               asp-action="Index">
                                                💬 Hỗ trợ / Phản ánh
                                            </a>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="DbManage"
                                               asp-action="Index">
                                                🗄️ Quản lý CSDL
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <!-- ================= ACCOUNT ================= -->
                    <div class="d-flex align-items-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-area="Identity" asp-page="/Account/Manage/Index"
                               class="navbar-text me-3 text-decoration-none">
                                👤 @User.Identity.Name
                            </a>

                            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    🚪 Đăng xuất
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm me-2" asp-area="Identity" asp-page="/Account/Login">
                                🔑 Đăng nhập
                            </a>

                            <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">
                                📝 Đăng ký
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ================= MAIN ================= -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="border-top footer text-muted">
        <div class="container text-center py-3">
            &copy; 2026 - EZ-Rent - Nhóm WNC.G07
            | <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>